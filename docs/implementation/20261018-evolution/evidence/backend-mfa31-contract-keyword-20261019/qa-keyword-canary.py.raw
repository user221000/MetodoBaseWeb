"""Independent compatibility canaries for the existing named clock argument."""
from datetime import timedelta

import pytest


def test_named_aware_now_keeps_original_service_contract():
    from tests import mfa31_contract_client as helper
    from web.services import mfa_service as service
    original = service.instant
    explicit = original() - timedelta(seconds=10)
    assert original(now=explicit) == explicit
    try:
        with helper._authentication_clock():
            assert service.instant(now=explicit) == explicit
    finally:
        assert service.instant is original
        assert helper._AUTHENTICATION_INSTANT.get() is None


def test_named_naive_now_keeps_original_validator():
    from tests import mfa31_contract_client as helper
    from web.services import mfa_service as service
    original = service.instant
    invalid = original().replace(tzinfo=None)
    with pytest.raises(ValueError):
        original(now=invalid)
    try:
        with helper._authentication_clock():
            with pytest.raises(ValueError):
                service.instant(now=invalid)
    finally:
        assert service.instant is original
        assert helper._AUTHENTICATION_INSTANT.get() is None
