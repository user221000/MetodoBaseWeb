@@ -0,0 +1,21 @@
+.retirement-page { max-width: 48rem; margin: 1.5rem auto; padding: 1.75rem; font: 1rem/1.6 system-ui, sans-serif; color: #19343a; background: #fff; }
+.retirement-page, .retirement-page * { box-sizing: border-box; min-width: 0; }
+.retirement-page h1 { font-size: clamp(1.7rem, 6vw, 2.3rem); line-height: 1.2; }
+.retirement-page h2 { font-size: 1.35rem; }
+.retirement-page p, .retirement-page li { overflow-wrap: anywhere; }
+.retirement-page a { color: #075d60; text-underline-offset: .2em; }
+.retirement-page label { display: block; font-weight: 650; margin-top: 1rem; }
+.retirement-page input, .retirement-page select { display: block; width: 100%; font: inherit; min-height: 2.75rem; padding: .6rem; border: 1px solid #597571; border-radius: .3rem; color: #19343a; background: #fff; }
+.retirement-page button { font: inherit; min-height: 2.75rem; max-width: 100%; padding: .65rem 1rem; border: 2px solid #075d60; border-radius: .35rem; color: #fff; background: #075d60; cursor: pointer; }
+.retirement-page button.secondary { background: #fff; color: #075d60; }
+.retirement-page button:disabled { color: #415956; background: #e5eeeb; border-color: #a5b8b1; cursor: default; }
+.retirement-actions, .retirement-page nav { display: flex; flex-wrap: wrap; gap: .8rem; margin: 1rem 0; }
+.retirement-page nav a { display: inline-flex; align-items: center; min-height: 2.75rem; }
+.retirement-page aside, .retirement-page section { border-top: 1px solid #bccfc8; margin-top: 2rem; padding-top: 1rem; }
+.retirement-page ol { padding-left: 1.4rem; }
+.retirement-page article { border: 1px solid #aec6bc; border-radius: .4rem; margin: 1rem 0; padding: 1rem; }
+.retirement-page article h3 { margin-top: 0; }
+.retirement-error { color: #80212a; background: #fff6f6; border: 2px solid #a12a35; border-radius: .4rem; padding: 1rem; }
+.retirement-page :focus-visible, .retirement-page [tabindex="-1"]:focus { outline: 3px solid #9a4800; outline-offset: 3px; }
+.retirement-page [hidden] { display: none !important; }
+@media (max-width: 36rem) { .retirement-page { margin: 0; padding: 1rem; } .retirement-actions button { width: 100%; } }
