import sys,json,hashlib
from pathlib import Path
OUT=Path('F:/MetodoBaseWeb-execution-20261018/docs/implementation/20261018-evolution/evidence/qa-r23-ci-independent-20261019')
def compare(before,after):
    assert {k:v for k,v in before.items() if k not in ('new_helpers','helper_count')}=={k:v for k,v in after.items() if k not in ('new_helpers','helper_count')}
    old=before['new_helpers'];new=after['new_helpers']
    assert all(new.get(n)==h for n,h in old.items())
    receipts={}
    for result_name in ('process5-result.json','own-result.json'):
        result=json.loads((OUT/result_name).read_bytes())
        for record in result['outputs']:
            name=record['public_file']
            if name.endswith('--writer.py'):
                source=Path(record['private_original']);target=OUT/name
                assert record['public_is_RAW_exact'] is True
                assert hashlib.sha256(source.read_bytes()).hexdigest()==record['original_sha256']==record['public_sha256']==hashlib.sha256(target.read_bytes()).hexdigest()
                receipts[name]=record
    extra=set(new)-set(old)
    assert extra<=set(receipts)
    for name in extra:assert new[name]==receipts[name]['public_sha256']
    assert all(n.endswith('--writer.py') for n in extra)
    # Exact generated bytes must match the frozen maintained inert-writer generator.
    import ast
    root=Path('F:/mb-r23-ci-qa-20261019')
    module=ast.parse((root/'tests/test_followup_ci_process.py').read_bytes())
    strings=[node.value for node in ast.walk(module) if isinstance(node,ast.Constant) and isinstance(node.value,str)]
    for name in extra:
        raw=(OUT/name).read_bytes()
        assert any(value.encode()==raw or value.encode().replace(b'\r\n',b'\n')==raw.replace(b'\r\n',b'\n') for value in strings),'Unexpected writer generator bytes'
    return {'original_photo_unchanged':True,'maintained_sources':before['source_count'],'packages':89,'original_helpers':len(old),'original_helpers_byte_unchanged':True,'generated_artifact_delta':[{**receipts[n],'name':n,'sha256':new[n]} for n in sorted(extra)],'only_changed_keys':['new_helpers','helper_count'] if extra else [],'no_generic_exclusions':True}
