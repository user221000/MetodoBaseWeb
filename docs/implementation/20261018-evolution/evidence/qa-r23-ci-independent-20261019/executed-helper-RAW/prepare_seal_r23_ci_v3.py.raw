from pathlib import Path
import json,hashlib
temp=Path('C:/Users/Consu/AppData/Local/Temp');source=temp/'seal_r23_ci_review_v2.py';text=source.read_text()
start=text.index('helper_records=');end=text.index('own=json.loads')
replacement='''helper_dir=OUT/'executed-helper-RAW'
for p in [Path(__file__),Path('C:/Users/Consu/AppData/Local/Temp/prepare_seal_r23_ci_v3.py')]:
    target=helper_dir/(p.name+'.raw');assert not target.exists();target.write_bytes(p.read_bytes())
helper_records=[{'RAW_file':p.relative_to(OUT).as_posix(),'sha256':sha(p.read_bytes()),'RAW_exact':True}for p in sorted(helper_dir.iterdir())if p.is_file()]
save('final-seal-helper-inventory.json',{'files':helper_records,'original_executing_helpers':5,'additional_executed_preparation_recovery_seal_helpers':len(helper_records)-5,'RAW_copies_only':True})
save('seal-prefix-reporting-error.json',{'original_sealer_v2_exit':1,'original_script_RAW':'executed-helper-RAW/seal_r23_ci_review_v2.py.raw','failure':'Sealer guessed manifest.json for previously partial scope. Actual immutable name partial-manifest.json was already authenticated by initial preparation.','correction':'Read literal previously authenticated filename and SHA; previous prefixes untouched, no tests repeated.','no_product_change_or_regression':True})
'''
text=text[:start]+replacement+text[end:]
text=text.replace("for prefix in ['qa-r23-composition30-independent-20261019','qa-r23-focus-independent-20261019']:\n    path=OUT.parent/prefix;manifest=json.loads((path/'manifest.json').read_bytes())","for prefix,manifest_name,digest in [('qa-r23-composition30-independent-20261019','partial-manifest.json','76eceb4053df86d4ef41b6f45dceeddf8232c0f52c8709c7ec23b5d9d7012650'),('qa-r23-focus-independent-20261019','manifest.json','43d78445c7a90cae3b997aa4dc63c648eef3f1f7b877d7ea196fb71a9bf69880')]:\n    path=OUT.parent/prefix;assert sha((path/manifest_name).read_bytes())==digest;manifest=json.loads((path/manifest_name).read_bytes())")
text=text.replace("'manifest_sha256':sha((path/'manifest.json').read_bytes())","'manifest_sha256':sha((path/manifest_name).read_bytes())")
old="'credential_URL':re.compile(rb'postgres(?:ql)?(?:\\+psycopg2)?://[^\\s\\x22\\x27<>]+')"
new="'credential_URL':re.compile(rb'postgres(?:ql)?(?:\\+psycopg2)?://[^/\\s\\x22\\x27<>:]+:[^/@\\s\\x22\\x27<>]+@')"
assert text.count(old)==1;text=text.replace(old,new)
target=temp/'seal_r23_ci_review_v3.py';target.write_text(text,encoding='utf8',newline='\n')
print(json.dumps({'prepared':True,'sha256':hashlib.sha256(target.read_bytes()).hexdigest()}))
