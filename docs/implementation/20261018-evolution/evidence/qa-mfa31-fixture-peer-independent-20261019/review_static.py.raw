"""Independent exact criteria-preservation checks; no service or source mutation."""
import ast, hashlib, json, subprocess
from pathlib import Path
R=Path('F:/mb-mfa31-summary-after-qa-20261019')
E=Path('F:/MetodoBaseWeb-execution-20261018/docs/implementation/20261018-evolution/evidence/qa-mfa31-fixture-peer-independent-20261019')
sha=lambda b:hashlib.sha256(b).hexdigest()
git=lambda *a:subprocess.check_output(['git','--no-replace-objects',*a],cwd=R)
base='913cb66061ac754ad09344fc24e8f769b5722997'
rows=[]
for path in ['tests/test_team_invitation_contract.py','tests/test_team_entitlement_review.py','tests/test_personal_diary_security_review.py']:
    before=git('show',base+':'+path)
    after=(R/path).read_bytes()
    old=ast.parse(before);new=ast.parse(after)
    oldtests={n.name:n for n in old.body if isinstance(n,ast.FunctionDef)and n.name.startswith('test_')}
    newtests={n.name:n for n in new.body if isinstance(n,ast.FunctionDef)and n.name.startswith('test_')}
    assert oldtests.keys()==newtests.keys()
    identical=0;changed=0;added=0
    for name,fn in oldtests.items():
        previous=[n for n in ast.walk(fn)if isinstance(n,ast.Assert)]
        current=[ast.dump(n,include_attributes=False)for n in ast.walk(newtests[name])if isinstance(n,ast.Assert)]
        for n in previous:
            if path.endswith('test_team_invitation_contract.py')and name=='test_team_mutations_never_cross_to_another_gym'and ast.unparse(n)=='assert response.status_code == 404':
                assert ast.dump(ast.parse('assert response.status_code == 403').body[0],include_attributes=False) in current
                changed+=1
            else:
                assert ast.dump(n,include_attributes=False) in current,(path,name)
                identical+=1
        added+=len(current)-len(previous)
    rows.append({'path':path,'old_test_functions':len(oldtests),'old_Assert_nodes_AST_exact':identical,'approved_404_to_403_node':changed,'added_Assert_nodes':added,'before_GitLF_SHA':sha(before),'current_RAW_SHA':sha(after),'current_GitLF_SHA':sha(after.replace(b'\r\n',b'\n'))})
assert [(r['old_Assert_nodes_AST_exact'],r['approved_404_to_403_node'])for r in rows]==[(100,1),(9,0),(66,0)]
conftest=(R/'conftest.py').read_bytes()
assert conftest.replace(b'\r\n',b'\n')==git('show',base+':conftest.py')
changes=git('diff-tree','--no-commit-id','--name-only','-r','dab090679a48cb8b064804a13622c415db0a170b').decode().splitlines()
assert len(changes)==5 and all(p.startswith('tests/')for p in changes)
legacy=(R/'tests/e2e/member_link_consumers.cjs').read_text(encoding='utf8')
new=(R/'tests/e2e/member_link_consumers31.cjs').read_text(encoding='utf8')
segment=lambda s:s[s.index('const tests=[];'):s.index('(async()=>{const results=[];')]
assert segment(legacy)==segment(new)
assert segment(new).count("test('")==16
proof={'source_head':git('rev-parse','HEAD').decode().strip(),'DAB_only_test_paths':changes,'criteria':rows,'global_conftest_exact_GitLF_vs913':True,'member31_16_callback_bodies_and_Assert_bytes_exact_LF_to_legacy':True,'member31_legacy_count':16,'fixture_review':{'MfaContractClient':'Uses persisted account/password, actual login+reauth+enroll+confirm+recovery login; caches bearer only, no identity/MFA auth dependency override. One exact method/path/body grant then actual original mutation; rejects issue does not substitute response. No business retry or refresh.','team_case':'Only get_db overridden to isolated SQLite; persisted bearer dependency real; account seed password now valid; no permission/MFA operation monkeypatch.','entitlement':'Module-local wrapper opts into MFA; ordinary conftest unchanged.','diary':'One Web OWNER setup authenticates+grants revocation; API branch and all66 prior assertion nodes exact.','member31':'Expands genuine template include IDs and actual R24 companion scripts in template order; APIv1/minimalDOM remains declared double, not browser/API acceptance.'},'historical_claim_correction':'Early author assert-preservation.json predates approved precedence change. Final map is100/101 invitation+9/9 entitlement,109/110; diary66/66 separately. No claim all110 remain identical.'}
(E/'static-review.json').write_text(json.dumps(proof,indent=2)+'\n')
print(json.dumps({'static_review_SHA':sha((E/'static-review.json').read_bytes()),'old_team_entitlement':110,'identical':109,'approved_changed':1,'diary_identical':66,'callback_exact':16}))
