/* Independent state sequences; only reviewed author fixture prefix reused. RAM transport, no backend acceptance. */
const fs=require('node:fs'),path=require('node:path'),Module=require('node:module'),assert=require('node:assert/strict');
const ROOT='F:/mb-mfa31-qa-20261019',base=path.join(ROOT,'tests/e2e'),marker='const tests=[];';
const apiSource=fs.readFileSync(path.join(base,'mfa_api.cjs'),'utf8'),stateSource=fs.readFileSync(path.join(base,'mfa_state.cjs'),'utf8');
assert.equal(apiSource.split(marker).length,2);assert.equal(stateSource.split('\n'+marker).length,2);
const environment=apiSource.slice(0,apiSource.indexOf(marker))+stateSource.slice(stateSource.indexOf('class Element{'),stateSource.indexOf('\n'+marker));
const scenarios=String.raw`
const tests=[];const test=(name,body)=>tests.push({name,body});
test('Concurrent verify presses issue only one factor HTTP request while its response is held',async()=>{const gate=deferred(),e=stateFixture(url=>url==='/api/auth/login'?Response.json(challenge(),{status:202}):url.includes('/login/verify')?gate.promise:null);await e.login.primary('password',{});const first=e.login.verify('123456');await new Promise(r=>setImmediate(r));assert.equal(await e.login.verify('654321'),false);gate.resolve(Response.json({...other,tipo:'usuario'}));await first;assert.equal(e.calls.filter(x=>x.url.includes('/login/verify')).length,1);assert.equal(e.seen.closed,1);});
test('Changing the method back to TOTP never carries the old recovery value into verification',async()=>{const e=stateFixture(url=>url==='/api/auth/login'?Response.json(challenge(),{status:202}):url.includes('/login/verify')?Response.json({...other,tipo:'usuario'}):null);await e.login.primary('password',{});e.login.selectMethod('recovery_code');e.login.selectMethod('totp');assert.equal(await e.login.verify('R'.repeat(22)),false);await e.login.verify('123456');const bodies=e.calls.filter(x=>x.url.includes('/login/verify')).map(x=>JSON.parse(x.body));assert.equal(bodies.length,1);assert.equal(bodies[0].code,'123456');assert.equal(bodies[0].recovery_code,undefined);});
test('An expired seed cannot emit a confirm request or recovery kit',async()=>{const e=stateFixture(url=>url==='/api/auth/mfa/enroll'?Response.json({enrollment_id:'e'.repeat(32),secret:'A'.repeat(32),otpauth_uri:'otpauth://totp/synthetic',shown_once:true,expires_at:'2020-01-01T00:00:00Z'}):null);await e.account.load();await e.account.mutate('enroll',{password:'synthetic'},{});const before=e.calls.length;assert.equal(await e.account.confirm('123456'),false);assert.equal(e.calls.length,before);assert.equal(e.seen.kit,0);assert.equal(e.values.get('mb_token'),old.token);});
test('A held regeneration acknowledgement cannot render an old kit after a raw storage replacement without event',async()=>{const gate=deferred(),e=stateFixture(url=>url.includes('regenerate')?gate.promise:null,true);await e.account.load();const pending=e.account.mutate('regenerate',{password:'synthetic'},{code:'123456'});await new Promise(r=>setImmediate(r));e.values.set('mb_token',other.token);e.values.set('mb_refresh_token',other.refresh_token);gate.resolve(Response.json({success:true,shown_once:true,reauthenticate:true,recovery_codes:codes()}));await pending;assert.equal(e.seen.kit,0);assert.equal(e.values.get('mb_token'),other.token);assert.equal(e.root.textContent.includes('R'.repeat(20)),false);});
test('Duplicate recovery entries in a successful-looking confirm response cannot clear credentials or render kit',async()=>{const e=stateFixture(url=>url.includes('/enroll/confirm')?Response.json({success:true,enabled:true,shown_once:true,reauthenticate:true,recovery_codes:Array(8).fill('R'.repeat(22))}):null);await e.account.load();await e.account.mutate('enroll',{password:'synthetic'},{});assert.equal(await e.account.confirm('123456'),false);assert.equal(e.seen.kit,0);assert.equal(e.values.get('mb_token'),old.token);});
test('A confirm acknowledgement with enabled=false cannot announce activation or reveal its kit',async()=>{const e=stateFixture(url=>url.includes('/enroll/confirm')?Response.json({success:true,enabled:false,shown_once:true,reauthenticate:true,recovery_codes:codes()}):null);await e.account.load();await e.account.mutate('enroll',{password:'synthetic'},{});assert.equal(await e.account.confirm('123456'),false);assert.equal(e.seen.kit,0);assert.equal(e.values.get('mb_token'),old.token);});
test('An old discarded Google intent remains inert after a new Google intent starts',async()=>{const e=stateFixture(url=>url==='/api/auth/google'?Response.json(challenge(),{status:202}):null);const first=e.login.beginGoogle();e.login.cancel();const second=e.login.beginGoogle();assert.notEqual(first,second);assert.equal(await e.login.completeGoogle({credential:'synthetic-old'},first),false);assert.equal(e.calls.length,0);await e.login.completeGoogle({credential:'synthetic-new'},second);assert.equal(e.calls.length,1);assert.equal(e.login.phase,'factor');});
test('Storage removal failure at a confirmed kit ACK never renders secrets or calls success callbacks',async()=>{const e=stateFixture();await e.account.load();await e.account.mutate('enroll',{password:'synthetic'},{});e.context.localStorage.removeItem=()=>{throw new Error('Synthetic denied storage');};assert.equal(await e.account.confirm('123456'),false);assert.equal(e.seen.kit,0);assert.equal(e.seen.closed,0);assert.equal(e.root.textContent.includes('R'.repeat(20)),false);assert.ok(e.seen.errors>0);});
test('Pagehide during primary reauthentication prevents the later enroll request entirely',async()=>{const gate=deferred(),e=stateFixture(url=>url==='/api/auth/mfa/reauth'?gate.promise:null);await e.account.load();const pending=e.account.mutate('enroll',{password:'synthetic'},{});await new Promise(r=>setImmediate(r));e.window.dispatchEvent(new Event('pagehide'));gate.resolve(Response.json({reauthentication_token:'p'.repeat(43),expires_at:'2099-10-19T18:00:00Z'}));await pending;assert.equal(e.calls.filter(x=>x.url==='/api/auth/mfa/enroll').length,0);assert.equal(e.seen.seed,0);assert.equal(e.account.active,false);});
test('An uncertain regeneration503 emits no automatic followup and preserves the new account if switched afterward',async()=>{const e=stateFixture(url=>url.includes('regenerate')?Response.json({detail:{code:'mfa_unconfirmed'}},{status:503}):null,true);await e.account.load();await e.account.mutate('regenerate',{password:'synthetic'},{code:'123456'});const count=e.calls.length;await new Promise(r=>setImmediate(r));assert.equal(e.calls.length,count);assert.equal(e.seen.kit,0);assert.equal(e.states.at(-1).state,'unconfirmed');e.api.saveTokens(other);assert.equal(e.values.get('mb_token'),other.token);assert.equal(e.account.active,false);});
(async()=>{const results=[];for(const entry of tests){try{await entry.body();results.push({case:entry.name,passed:true});}catch(error){results.push({case:entry.name,passed:false,error_class:error.name});}}console.log(JSON.stringify({scope:'Independent state sequences on actual api.js/mfa-login.js/mfa-ui.js; minimal fixture DOM and explicit RAM transport, no backend/PG/browser/provider claim',total:results.length,passed:results.filter(x=>x.passed).length,results},null,2));if(results.some(x=>!x.passed))process.exitCode=1;})();
`;
const candidate=new Module(path.join(base,'qa_mfa_state_independent.cjs'),module);candidate.filename=path.join(base,'qa_mfa_state_independent.cjs');candidate.paths=module.paths;candidate._compile(environment+scenarios,candidate.filename);
