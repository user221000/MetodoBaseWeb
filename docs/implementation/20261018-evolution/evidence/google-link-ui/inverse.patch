-.google-link-error { color: #80212a; background: #fff6f6; border: 2px solid #a12a35; padding: 1rem; border-radius: .4rem; }
-.google-link-page .google-link-check { display: flex; align-items: flex-start; gap: .7rem; margin: 1rem 0; }
