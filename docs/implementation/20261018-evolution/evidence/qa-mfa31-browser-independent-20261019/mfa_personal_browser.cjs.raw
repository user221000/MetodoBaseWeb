/* Focal personal login200/202 + factor controls; same own migrated SQLite31 fixture. */
const fs=require('node:fs'),path=require('node:path'),assert=require('node:assert/strict'),crypto=require('node:crypto');
const deps=process.env.METODOBASE_E2E_DEPENDENCIES||path.resolve(__dirname,'node_modules'),{chromium}=require(path.join(deps,'playwright-core')),base='http://127.0.0.1:8805';
if(process.env.METODOBASE_E2E_URL&&process.env.METODOBASE_E2E_URL!==base)throw Error('Own8805 only');
const batch=process.env.METODOBASE_EVIDENCE_BATCH;if(!batch||!/^[A-Za-z0-9_-]{1,80}$/.test(batch))throw Error('Explicit fresh batch required');
const out="F:/MetodoBaseWeb-execution-20261018/docs/implementation/20261018-evolution/evidence/qa-mfa31-browser-independent-20261019/personal";if(fs.existsSync(out))throw Error('Evidence exists');fs.mkdirSync(out,{recursive:true});
const report={scope:'Focal personal UI/auth/MFA actual SQLite31/HTTP. Registration is real VIEWER. No Google/provider or PostgreSQL claim.',driver_raw_sha256:crypto.createHash('sha256').update(fs.readFileSync(__filename)).digest('hex'),checks:[],screens:[],pageErrors:[]};
function totp(secret){let bits=0,value=0;const bytes=[];for(const char of secret){value=(value<<5)|'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567'.indexOf(char);bits+=5;if(bits>=8){bits-=8;bytes.push((value>>>bits)&255);}}const counter=Buffer.alloc(8);counter.writeBigUInt64BE(BigInt(Math.floor(Date.now()/30000)));const hash=crypto.createHmac('sha1',Buffer.from(bytes)).update(counter).digest(),offset=hash[19]&15;return String((hash.readUInt32BE(offset)&0x7fffffff)%1000000).padStart(6,'0');}
(async()=>{let browser,context,page,codes=[];try{
 browser=await chromium.launch({headless:true,executablePath:process.env.CHROME_PATH||'C:/Program Files/Google/Chrome/Application/chrome.exe'});context=await browser.newContext({viewport:{width:320,height:900},timezoneId:'America/Mexico_City'});await context.route('**/*',route=>new URL(route.request().url()).origin===base?route.continue():route.abort());page=await context.newPage();page.on('pageerror',error=>report.pageErrors.push(error.name));
 const password='Synthetic-MFA-UI-Password-2026!',email='mfa-personal-'+crypto.randomUUID()+'@example.invalid';
 const registration=await context.request.post(base+'/api/auth/registro',{data:{email,password,nombre:'Synthetic personal MFA',tipo:'usuario'}});assert.equal(registration.status(),200);
 async function screen(name,selector){await page.locator(selector).scrollIntoViewIfNeeded();await page.evaluate(async()=>Promise.all(document.getAnimations().filter(value=>value.effect.getTiming().iterations!==Infinity).map(value=>value.finished.catch(()=>{}))));await page.evaluate(fs.readFileSync(path.join(deps,'axe-core/axe.min.js'),'utf8'));const result=await page.evaluate(async selector=>({overflow:document.documentElement.scrollWidth>innerWidth,axe:(await axe.run(document.querySelector(selector),{runOnly:{type:'tag',values:['wcag2a','wcag2aa','wcag21aa','wcag22aa']}})).violations.map(value=>({id:value.id,targets:value.nodes.map(node=>node.target)}))}),selector);fs.writeFileSync(path.join(out,name+'-axe.json'),JSON.stringify(result,null,2));await page.screenshot({path:path.join(out,name+'.png'),fullPage:true});report.screens.push({name,...result});assert.deepEqual(result.axe,[]);assert.equal(result.overflow,false);}
 async function primary(){await page.goto(base+'/login-usuario');await page.locator('#loginForm [name=email]').fill(email);await page.locator('#pwdField').fill(password);await page.locator('#submitBtn').click();}
 await page.goto(base+'/login-usuario');await screen('personal-primary-320','#loginForm');await primary();await page.waitForURL('**/mi-plan');report.checks.push('Personal password200 establishes its canonical VIEWER session');
 await page.goto(base+'/mi-perfil');await page.waitForFunction(()=>!document.getElementById('mfa-account-submit').disabled);await page.locator('#mfa-account-password').fill(password);await page.locator('#mfa-account-submit').click();await page.locator('#mfa-account-seed .mfa-secret').waitFor();const seed=await page.locator('#mfa-account-seed .mfa-secret').textContent();await page.locator('#mfa-account-new-code').fill(totp(seed));await page.locator('#mfa-account-confirm button[type=submit]').click();await page.locator('#mfa-account-kit li').first().waitFor();codes=await page.locator('#mfa-account-kit li').allTextContents();assert.equal(codes.length,8);assert.equal(await page.evaluate(()=>localStorage.getItem('mb_token')),null);report.checks.push('Personal account confirms factor, closes and shows its own eight-code kit');
 await primary();await page.locator('#mfa-login-factor').waitFor({state:'visible'});await screen('personal-factor-320','#mfa-login-panel');assert.equal(await page.evaluate(()=>localStorage.getItem('mb_token')),null);report.checks.push('Personal password202 has no early credentials or navigation');
 await page.locator('#mfa-login-method').selectOption('recovery_code');await page.locator('#mfa-login-recovery').fill('invalid');await page.locator('#mfa-login-factor button[type=submit]').click();assert.equal(await page.locator('#mfa-login-factor').isVisible(),true);assert.equal(await page.evaluate(()=>localStorage.getItem('mb_token')),null);await page.locator('#mfa-login-recovery').fill(codes[0]);await page.locator('#mfa-login-factor button[type=submit]').click();await page.waitForURL('**/mi-plan');assert.equal(await page.evaluate(async()=> (await Api.auth.me()).role),'viewer');report.checks.push('Explicit valid recovery succeeds; incomplete local proof cannot open the account or add a role');
 await page.goto(base+'/mi-perfil');await page.waitForFunction(()=>!document.getElementById('mfa-account-submit').disabled);await page.setViewportSize({width:768,height:900});await screen('personal-security-768','#mfa-account');assert.deepEqual(report.pageErrors,[]);report.complete=true;
 }catch(error){report.complete=false;report.failure_class=error.name;report.failure_locations=String(error.stack||'').split('\n').slice(1).filter(line=>/^\s+at /.test(line));process.exitCode=1;}
 finally{codes.fill('');await context?.close();await browser?.close();fs.writeFileSync(path.join(out,'report.json'),JSON.stringify(report,null,2));console.log(JSON.stringify({complete:report.complete,checks:report.checks.length,screens:report.screens.length,error_class:report.failure_class||null,own_browser_closed:true}));}
})();
