    "gym": "canonical OWNER only; no ADMIN billing grant added",
    "personal": "canonical nonOWNER personal subject; no profile adoption",
    "writes": "No extra step-up action: consent/queue/cancel affect only own account. Existing billing/team step-up remains unchanged."
  },
  "privacy": {
    "all_statuses": "exact API route shapes and /notificaciones/excluir, including trailing slash, use no-store/no-referrer and fixed first-party CSP",
