    "uuid": "lowercase UUID36; source_hash lowercase SHA25664",
    "interval_hours": [
      24,
      72,
      168
    ],
    "outbox_list": {
      "limit_default": 20,
      "limit_maximum": 50,
      "after": "optional lowercase outbox UUID; ascending UUID keyset"
    },
    "metrics": {
      "from": "optional ISO civil date YYYY-MM-DD",
