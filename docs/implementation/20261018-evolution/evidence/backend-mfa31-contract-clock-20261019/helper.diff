+_AUTHENTICATION_INSTANT: ContextVar[datetime | None] = ContextVar(
+    "mfa_contract_authentication_instant", default=None)
+_CLOCK_OWNER = RLock()
+
+
+@contextmanager
+def _authentication_clock():
+    """One setup instant, request-context scoped, restored before business.
+
+    The temporary service wrapper delegates to the caller's original validator
+    whenever no setup ContextVar is present, including unrelated threads. Our
+    helpers serialize ownership; another clock installer is detected rather
+    than silently overwritten. This is a test-only isolated-fixture seam.
+    """
+    from web.services import mfa_service
+    with _CLOCK_OWNER:
+        if _AUTHENTICATION_INSTANT.get() is not None:
+            raise RuntimeError("Nested fixture authentication clock")
+        original = mfa_service.instant
+        observed = original().astimezone(timezone.utc)
+        def scoped(supplied=None):
+            fixed = _AUTHENTICATION_INSTANT.get()
+            return original(fixed if supplied is None and fixed is not None else supplied)
+        token = _AUTHENTICATION_INSTANT.set(observed)
+        mfa_service.instant = scoped
+        try:
+            yield observed
+        finally:
+            # Always clear our request tag, including when another actor has
+            # installed its own clock. Do not clobber that actor's function.
+            _AUTHENTICATION_INSTANT.reset(token)
+            if mfa_service.instant is not scoped:
+                raise RuntimeError("fixture clock ownership changed")
+            mfa_service.instant = original
+
