"""Independent file-backed CLI mutant and missing snapshot coverage; offline."""
import ast, hashlib, importlib.metadata, json, os, subprocess, sys
from pathlib import Path
R=Path('F:/mb-mfa-ci31-fix-qa-20261019')
M=Path('F:/mb-mfa-ci31-fix-cli-mutant-qa-20261019')
T=Path(__file__).parent
E=Path('F:/MetodoBaseWeb-execution-20261018/docs/implementation/20261018-evolution/evidence/qa-mfa-ci31-fix-independent-20261019')
SHA=lambda b:hashlib.sha256(b).hexdigest()
env=dict(os.environ,PYTHONUTF8='1',PYTHONDONTWRITEBYTECODE='1',PYTHON_DOTENV_DISABLED='1')
for key in list(env):
    upper=key.upper()
    if upper=='DATABASE_URL' or upper.endswith('_DATABASE_URL') or upper.startswith(('PG','AWS_','S3_','METODOBASE_TEST_','_METODOBASE_TEST')) or any(x in upper for x in ['STRIPE','MERCADOPAGO','RESEND','SMTP','SENTRY','OPENAI_API']):env.pop(key,None)
env['METODOBASE_CI_BASH']='C:/Program Files/Git/bin/bash.exe'
git=lambda root,*args:subprocess.check_output(['git','--no-replace-objects',*args],cwd=root)
names=git(R,'ls-files','-z').decode().strip('\0').split('\0')
def photo(root):
    return {'head':git(root,'rev-parse','HEAD').decode().strip(),'sources':{n:SHA((root/n).read_bytes())for n in names},'packages':sorted([d.metadata['Name'],d.version]for d in importlib.metadata.distributions()),'Python_SHA':SHA(Path(sys.executable).read_bytes()),'Python_base_SHA':SHA(Path(sys._base_executable).read_bytes()),'Bash_SHA':SHA(Path(env['METODOBASE_CI_BASH']).read_bytes()),'helpers':{p.name:SHA(p.read_bytes())for p in T.glob('*.py')}}
before=photo(R);assert len(before['packages'])==89
(E/'before.json').write_text(json.dumps(before,indent=2)+'\n')
assert git(R,'status','--porcelain').strip()==b''
pip=subprocess.run([sys.executable,'-m','pip','check'],capture_output=True,env=env);(E/'pip-before.log').write_bytes(pip.stdout+pip.stderr);assert pip.returncode==0
empty=T/'empty-reports';empty.mkdir()
def run(name,root,args):
    p=subprocess.run([sys.executable,'-X','utf8',*args],cwd=root,env=env,capture_output=True,timeout=180)
    (E/(name+'.stdout.raw.log')).write_bytes(p.stdout);(E/(name+'.stderr.raw.log')).write_bytes(p.stderr)
    return p.returncode
baseline_reject=run('baseline-empty-cli',R,['tests/check_mfa31_reports.py','--directory',str(empty)])
assert baseline_reject==1
baseline_full=run('baseline-full-verifier',R,['tests/verify_mfa31_ci.py','--output',str(T/'baseline-full')])
assert baseline_full==0
target=M/'tests/check_mfa31_reports.py';original=target.read_bytes();source=original.decode('utf8');tree=ast.parse(source);fn=next(n for n in tree.body if isinstance(n,ast.FunctionDef)and n.name=='main');lines=source.splitlines(keepends=True)
mutant=''.join(lines[:fn.lineno-1])+'def main() -> int:\n    return 0\n'+''.join(lines[fn.end_lineno:]);assert ast.dump(ast.parse(mutant).body[-1],include_attributes=False)==ast.dump(tree.body[-1],include_attributes=False)
target.write_text(mutant,encoding='utf8',newline='\n');(E/'checker-main-false-success-mutant.raw.py').write_bytes(target.read_bytes())
mutant_before=photo(M);(E/'mutant-before.json').write_text(json.dumps(mutant_before,indent=2)+'\n')
mutant_empty=run('mutant-empty-cli',M,['tests/check_mfa31_reports.py','--directory',str(empty)])
mutant_full=run('mutant-full-verifier',M,['tests/verify_mfa31_ci.py','--output',str(T/'mutant-full')])
mutant_after=photo(M);assert mutant_before==mutant_after
(E/'mutant-after.json').write_text(json.dumps(mutant_after,indent=2)+'\n')
after=photo(R);(E/'after.json').write_text(json.dumps(after,indent=2)+'\n');assert before==after
pip=subprocess.run([sys.executable,'-m','pip','check'],capture_output=True,env=env);(E/'pip-after.log').write_bytes(pip.stdout+pip.stderr);assert pip.returncode==0
workflow=(R/'.github/workflows/ci.yml').read_text(encoding='utf8')
report={'source_head':before['head'],'baseline_empty_reports_CLI_exit':baseline_reject,'baseline_full_verifier_exit':baseline_full,'mutant_empty_reports_CLI_exit':mutant_empty,'mutant_full_verifier_exit':mutant_full,'checker_original_RAW_SHA':SHA(original),'checker_main_only_mutant_RAW_SHA':SHA(target.read_bytes()),'mutated_only':git(M,'diff','--name-only').decode().splitlines(),'maintained_validate_and173offline_canary_tests_unchanged':True,'static_snapshot_omission':{'source_exists':(R/'tests/e2e/daily_plan_snapshot.cjs').is_file(),'workflow_references':workflow.count('daily_plan_snapshot.cjs'),'guard_positive_without_snapshot':baseline_full==0,'missed_new_cases':7,'legacy_duplicates_not_new':18},'sources_packages_quiet':True,'source_files':len(names),'packages':89,'PG_Chrome_network_services_started':False,'decision':'REJECT if main-only false success and verifier both accepted; no PG contract acceptance'}
(E/'cli-and-coverage-review.json').write_text(json.dumps(report,indent=2)+'\n');print(json.dumps(report))
