  "sql": "SELECT history_candidates.id, history_candidates.fecha_generacion, history_candidates.kcal_objetivo, history_candidates.proteina_g, history_candidates.carbs_g, history_candidates.grasa_g, history_candidates.tipo_plan, history_candidates.pdf_object_id, history_candidates.ruta_pdf \nFROM (SELECT dated_page.id AS id, dated_page.fecha_generacion AS fecha_generacion, dated_page.kcal_objetivo AS kcal_objetivo, dated_page.proteina_g AS proteina_g, dated_page.carbs_g AS carbs_g, dated_page.grasa_g AS grasa_g, dated_page.tipo_plan AS tipo_plan, dated_page.pdf_object_id AS pdf_object_id, dated_page.ruta_pdf AS ruta_pdf \nFROM (SELECT planes_generados.id AS id, planes_generados.fecha_generacion AS fecha_generacion, planes_generados.kcal_objetivo AS kcal_objetivo, planes_generados.proteina_g AS proteina_g, planes_generados.carbs_g AS carbs_g, planes_generados.grasa_g AS grasa_g, planes_generados.tipo_plan AS tipo_plan, planes_generados.pdf_object_id AS pdf_object_id, planes_generados.ruta_pdf AS ruta_pdf \nFROM planes_generados JOIN clientes ON clientes.id_cliente = planes_generados.id_cliente \nWHERE planes_generados.gym_id = %(gym_id_1)s AND clientes.gym_id = %(gym_id_2)s AND planes_generados.deleted_at IS NULL AND clientes.deleted_at IS NULL AND planes_generados.id_cliente = %(id_cliente_1)s AND planes_generados.fecha_generacion IS NOT NULL AND (planes_generados.fecha_generacion, planes_generados.id) < (%(param_1)s, %(param_2)s) ORDER BY planes_generados.fecha_generacion DESC NULLS LAST, planes_generados.id DESC \n LIMIT %(param_3)s) AS dated_page UNION ALL SELECT undated_page.id AS id, undated_page.fecha_generacion AS fecha_generacion, undated_page.kcal_objetivo AS kcal_objetivo, undated_page.proteina_g AS proteina_g, undated_page.carbs_g AS carbs_g, undated_page.grasa_g AS grasa_g, undated_page.tipo_plan AS tipo_plan, undated_page.pdf_object_id AS pdf_object_id, undated_page.ruta_pdf AS ruta_pdf \nFROM (SELECT planes_generados.id AS id, planes_generados.fecha_generacion AS fecha_generacion, planes_generados.kcal_objetivo AS kcal_objetivo, planes_generados.proteina_g AS proteina_g, planes_generados.carbs_g AS carbs_g, planes_generados.grasa_g AS grasa_g, planes_generados.tipo_plan AS tipo_plan, planes_generados.pdf_object_id AS pdf_object_id, planes_generados.ruta_pdf AS ruta_pdf \nFROM planes_generados JOIN clientes ON clientes.id_cliente = planes_generados.id_cliente \nWHERE planes_generados.gym_id = %(gym_id_1)s AND clientes.gym_id = %(gym_id_2)s AND planes_generados.deleted_at IS NULL AND clientes.deleted_at IS NULL AND planes_generados.id_cliente = %(id_cliente_1)s AND planes_generados.fecha_generacion IS NULL ORDER BY planes_generados.id DESC \n LIMIT %(param_4)s) AS undated_page) AS history_candidates ORDER BY history_candidates.fecha_generacion DESC NULLS LAST, history_candidates.id DESC \n LIMIT %(param_5)s",
