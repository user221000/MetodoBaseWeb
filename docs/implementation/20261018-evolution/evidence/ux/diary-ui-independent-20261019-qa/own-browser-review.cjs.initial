const {chromium}=require('playwright-core');
const assert=require('node:assert/strict'),fs=require('node:fs'),path=require('node:path');
const base='http://127.0.0.1:8778',out=__dirname;
const legacy={'mb_daily_1999-01-02':'UNIDENTIFIED daily {invalid','mb_water_1999-01-02':'UNIDENTIFIED water \u0001 \u00e9','mb_meals_1999-01-02':'UNIDENTIFIED meals [invalid','mb_meals_done_1999-01-02':'UNIDENTIFIED completion {invalid'};
const report={scope:'Own browser controls, actual isolated auth/logout/refresh/diary HTTP and named response/Storage doubles; no cross-tab/reload atomicity claim',checks:[],pageErrors:[]};
const deferred=()=>{let resolve;const promise=new Promise(r=>resolve=r);return{promise,resolve};};
(async()=>{const browser=await chromium.launch({executablePath:'C:/Program Files/Google/Chrome/Application/chrome.exe',headless:true});let contexts=[];try{
 async function context(){const c=await browser.newContext({viewport:{width:390,height:844}});contexts.push(c);await c.route('**/*',r=>new URL(r.request().url()).origin===base?r.continue():r.abort());for(const method of ['get','post','put','patch','delete','fetch']){const original=c.request[method].bind(c.request);c.request[method]=(url,opt={})=>{assert.equal(new URL(url).origin,base);return original(url,{...opt,maxRedirects:0});};}return c;}
 const api=await context();async function login(name='primary'){const r=await api.request.post(base+'/api/auth/login',{data:{email:'diary-'+name+'@example.invalid',password:'Synthetic-Diary-Password-2026!'}});assert.equal(r.status(),200);return r.json();}
 async function open(pair){const c=await context();await c.addInitScript(legacy=>{const native={get:Storage.prototype.getItem,set:Storage.prototype.setItem,remove:Storage.prototype.removeItem};window.__qaLegacy=()=>Object.fromEntries(Object.keys(legacy).map(k=>[k,native.get.call(localStorage,k)]));window.__qaRestore=()=>{Storage.prototype.getItem=native.get;Storage.prototype.setItem=native.set;Storage.prototype.removeItem=native.remove;};for(const [key,value]of Object.entries(legacy))native.set.call(localStorage,key,value);for(const [op,method]of [['get','getItem'],['set','setItem'],['remove','removeItem']])Storage.prototype[method]=function(key,...args){if(/^(mb_daily_|mb_water_|mb_meals_|mb_meals_done_)/.test(key))throw Error('QA forbids unidentified legacy access '+op);return native[op].call(this,key,...args);};Storage.prototype.clear=function(){throw Error('QA forbids whole Storage clear');};},legacy);const p=await c.newPage();p.on('pageerror',e=>report.pageErrors.push(e.message));await p.goto(base+'/login-usuario');await p.evaluate(pair=>{localStorage.setItem('mb_token',pair.token);localStorage.setItem('mb_refresh_token',pair.refresh_token);localStorage.setItem('mb_tipo','usuario');},pair);await p.goto(base+'/mi-plan');await p.waitForFunction(()=>document.querySelector('#diary-status')?.textContent.includes('Datos consultados'));return{c,p};}
 async function logout(p){if(await p.locator('#btn-hamburger').isVisible()&&await p.locator('#btn-hamburger').getAttribute('aria-expanded')==='false')await p.locator('#btn-hamburger').click();await p.locator('#btn-logout').click();}
 async function intact(p){assert.deepEqual(await p.evaluate(()=>window.__qaLegacy()),legacy);}
 async function check(name,fn){await fn();report.checks.push(name);console.log(name);}
 await check('Own invalid-access logout rotates once through real HTTP refresh, closes the canonical session and preserves unidentified legacy bytes',async()=>{const pair=await login();const{p,c}=await open(pair);await p.evaluate(()=>Api.saveTokens({token:'qa-invalid-access',refresh_token:localStorage.getItem('mb_refresh_token')}));const calls=[];p.on('request',r=>{if(/\/api\/auth\/(refresh|logout)$/.test(r.url()))calls.push({method:r.method(),path:new URL(r.url()).pathname});});await logout(p);await p.waitForURL(base+'/login-usuario');assert.equal(calls.filter(r=>r.path.endsWith('/refresh')).length,1);assert.equal(calls.filter(r=>r.path.endsWith('/logout')).length,2);assert.deepEqual(await p.evaluate(()=>[localStorage.getItem('mb_token'),localStorage.getItem('mb_refresh_token')]),[null,null]);await intact(p);await c.close();});
 await check('Own lost delivery after actual logout commit closes locally without claiming server confirmation or redirecting; prior server credentials are revoked',async()=>{const pair=await login();const{p,c}=await open(pair);await p.route('**/api/auth/logout',async r=>{const response=await r.fetch({maxRedirects:0});assert.equal(response.status(),200);return r.abort('failed');});await logout(p);await p.waitForFunction(()=>document.querySelector('#logout-status')?.textContent.includes('No pudimos confirmar'));assert.equal(p.url(),base+'/mi-plan');assert.equal(await p.locator('#logout-status a').getAttribute('href'),'/login-usuario');assert.equal(await p.locator('#diary-snapshots').textContent(),'');assert.deepEqual(await p.evaluate(()=>[localStorage.getItem('mb_token'),localStorage.getItem('mb_refresh_token')]),[null,null]);assert.equal((await api.request.get(base+'/api/auth/me',{headers:{Authorization:'Bearer '+pair.token}})).status(),401);await intact(p);await c.close();});
 await check('Own first-removal Storage fault after real server logout blocks all later authenticated I/O; explicit empty-pair recovery and real login retain diary and exact legacy bytes',async()=>{const pair=await login();const{p,c}=await open(pair);await p.evaluate(()=>{const remove=Storage.prototype.removeItem;window.__qaRemove=remove;Storage.prototype.removeItem=function(key){if(key==='mb_token')throw new DOMException('QA synthetic sensitive Storage detail','SecurityError');return remove.call(this,key);};});await logout(p);await p.waitForFunction(()=>document.querySelector('#logout-status')?.textContent.includes('almacenamiento'));assert.ok(!(await p.locator('#logout-status').textContent()).includes('sensitive'));let requests=0;p.on('request',()=>requests++);const result=await p.evaluate(async()=>{const codes=[];for(const fn of [()=>Api.auth.me(),()=>Api.usuario.exportarDatos(),()=>Api.usuario.guardarDiario('2026-01-01',{operation:'water',expected_version:0,water_ml:1})])try{await fn();codes.push('UNEXPECTED');}catch(e){codes.push(e.code);}return codes;});assert.deepEqual(result,['session_storage_error','session_storage_error','session_storage_error']);assert.equal(requests,0);assert.equal(await p.locator('#diary-snapshots').textContent(),'');await intact(p);const recovery=await p.evaluate(async()=>{Storage.prototype.removeItem=window.__qaRemove;Api.clearTokens();const pair=await Api.auth.login({email:'diary-primary@example.invalid',password:'Synthetic-Diary-Password-2026!'});return{token:!!pair.token};});assert.equal(recovery.token,true);await p.goto(base+'/mi-plan');await p.waitForFunction(()=>document.querySelector('#diary-status')?.textContent.includes('Datos consultados'));assert.ok((await p.locator('#diary-water-current').textContent()).includes('1,100'));await intact(p);await c.close();});
 await check('Own old-SV day response held before logout in another authenticated context is discarded after canonical revalidation and cannot repaint the old snapshot',async()=>{const pair=await login();const{p,c}=await open(pair);const today=await p.locator('#diary-date').inputValue(),held=deferred(),release=deferred();let stalePaint=false;await p.exposeFunction('__qaStalePaint',()=>{stalePaint=true;});await p.route('**/api/usuario/diario/'+today,async r=>{assert.equal(r.request().method(),'GET');const response=await r.fetch({maxRedirects:0});assert.equal(response.status(),200);held.resolve();await release.promise;return r.fulfill({response});});await p.locator('#diary-reload').click();await held.promise;await p.evaluate(()=>{const node=document.querySelector('#diary-water-current');new MutationObserver(()=>{if(node.textContent.includes('1,100'))window.__qaStalePaint();}).observe(node,{childList:true,characterData:true,subtree:true});});assert.equal((await api.request.post(base+'/api/auth/logout',{headers:{Authorization:'Bearer '+pair.token}})).status(),200);release.resolve();await p.waitForURL(base+'/login-usuario');assert.equal(stalePaint,false);await intact(p);await c.close();});
 assert.deepEqual(report.pageErrors,[]);report.passed=true;
 }catch(e){report.passed=false;report.error=e.stack;console.error(e.stack);process.exitCode=1;}finally{fs.writeFileSync(path.join(out,'own-browser-report.json'),JSON.stringify(report,null,2));await browser.close();}})();
