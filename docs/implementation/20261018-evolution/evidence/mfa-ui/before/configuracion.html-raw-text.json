    },
    {
      "text": "\n/* ══════════════════════════════════════════════════════════════\n   configuracion.js — Gym Profile Management\n═════════════════════════════════════════════════════════════ */\n\nconst DURACION_ICONS = {\n  7: '📅',\n  30: '🗓️',\n  90: '📊',\n  180: '🏋️',\n  365: '🏆',\n};\n\nlet _planes = [];\n\n(async () => {\n  try {\n    await GymBranding.verifyAccount();\n    const res = await Api.gym.listarPlanes();\n    await GymBranding.verifyAccount();\n    _planes = res.planes || [];\n    renderPlanes(_planes);\n  } catch (e) {\n    document.getElementById('planes-loading').textContent = '⚠️ Error cargando planes: ' + e.message;\n  }\n})();\n\nfunction renderPlanes(planes) {\n  const grid = document.getElementById('planes-grid');\n  const loading = document.getElementById('planes-loading');\n  loading.style.display = 'none';\n  grid.style.display = 'grid';\n  grid.style.gridTemplateColumns = 'repeat(auto-fill, minmax(180px, 1fr))';\n  grid.innerHTML = '';\n\n  planes.forEach(plan => {\n    const icon = DURACION_ICONS[plan.duracion_dias] || '<img src=\"/static/img/shopping-cart.png\" style=\"width:20px;height:20px\">';\n    const card = document.createElement('div');\n    card.className = 'chart-container';\n    card.style.cssText = 'padding:20px;text-align:center;border:1px solid rgba(255,255,255,.06);';\n    card.innerHTML = `\n      <div style=\"font-size:28px;margin-bottom:8px;\">${icon}</div>\n      <h4 style=\"font-size:.95rem;font-weight:700;margin:0 0 4px 0;color:var(--text-primary);\">${esc(plan.nombre)}</h4>\n      <p class=\"text-xs text-muted\" style=\"margin-bottom:12px;\">${plan.duracion_dias} días</p>\n      <div class=\"input-group\" style=\"margin-bottom:12px;\">\n        <label class=\"input-label\" for=\"plan-precio-${plan.id}\" style=\"font-size:.75rem;\">Precio de ${esc(plan.nombre)} (${esc(plan.moneda)})</label>\n        <input\n          type=\"number\"\n          id=\"plan-precio-${plan.id}\"\n          class=\"input plan-precio-input\"\n          data-plan-id=\"${plan.id}\"\n          value=\"${plan.precio}\"\n          min=\"0\"\n          step=\"0.01\"\n          style=\"text-align:center;font-size:1.1rem;font-weight:700;\"\n        />\n      </div>\n      <button class=\"btn btn-primary btn-sm btn-guardar-plan\" data-permission=\"update:gym_profile\" data-plan-id=\"${plan.id}\" style=\"width:100%;font-size:.8rem;\">\n        Guardar\n      </button>\n    `;\n    card.querySelector('.plan-precio-input').disabled = !GymBranding.canUpdate();\n\n    // Event listener for save button\n    card.querySelector('.btn-guardar-plan').addEventListener('click', async (e) => {\n      const planId = e.currentTarget.dataset.planId;\n      const input = card.querySelector('.plan-precio-input');\n      const precio = parseFloat(input.value);\n      if (isNaN(precio) || precio < 0) {\n        Toast.error('El precio debe ser un número válido ≥ 0');\n        return;\n      }\n      const btn = e.currentTarget;\n      btn.disabled = true;\n      btn.textContent = '...';\n      try {\n        await GymBranding.verifyAccount();\n        await Api.gym.actualizarPlan(planId, { precio });\n        await GymBranding.verifyAccount();\n        Toast.success(`Precio de \"${plan.nombre}\" actualizado a $${precio.toFixed(2)}`);\n        const msg = document.getElementById('planes-saved-msg');\n        msg.style.display = 'block';\n        setTimeout(() => msg.style.display = 'none', 3000);\n      } catch (err) {\n        if (GymBranding.isActive()) Toast.error('Error: ' + err.message);\n      } finally {\n        btn.disabled = false;\n        btn.textContent = 'Guardar';\n      }\n    });\n\n    grid.appendChild(card);\n  });\n}\n"
    },
    {
      "text": "\n{% endblock %}\n"
    }
  ]
}
