    {
      "text": "\n    function togglePassword() {\n      const field = document.getElementById('pwdField');\n      field.type = field.type === 'password' ? 'text' : 'password';\n      const toggle = document.querySelector('.pwd-toggle');\n      toggle.setAttribute('aria-pressed', String(field.type === 'text'));\n      toggle.setAttribute('aria-label', field.type === 'text' ? 'Ocultar contraseña' : 'Mostrar contraseña');\n    }\n    document.querySelector('.pwd-toggle')?.addEventListener('click', togglePassword);\n\n    // ── Remember Me: restore saved email on page load ──\n    (function() {\n      const remembered = localStorage.getItem('mb_remember');\n      const savedEmail = localStorage.getItem('mb_email');\n      if (remembered === '1' && savedEmail) {\n        const emailField = document.querySelector('input[name=\"email\"]');\n        if (emailField) emailField.value = savedEmail;\n        document.getElementById('rememberMe').checked = true;\n      }\n    })();\n\n    document.getElementById('loginForm').addEventListener('submit', async (e) => {\n      e.preventDefault();\n      const form = e.target;\n      const errorMsg = document.getElementById('errorMsg');\n      const btn = document.getElementById('submitBtn');\n\n      errorMsg.style.display = 'none';\n      btn.disabled = true;\n      btn.textContent = 'Ingresando...';\n\n      const email    = form.email.value.trim();\n      const password = form.password.value;\n      const rememberMe = document.getElementById('rememberMe').checked;\n\n      try {\n        const res = await fetch('/api/auth/login', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ email, password, remember_me: rememberMe }),\n        });\n\n        const data = await res.json();\n\n        if (res.ok) {\n          if (data.tipo !== 'gym' && !data.team_gym_id) {\n            errorMsg.textContent = 'Esta cuenta no tiene acceso de gimnasio. ¿Eres miembro? Ingresa desde el portal de usuarios.';\n            errorMsg.style.display = 'block';\n            btn.disabled = false;\n            btn.textContent = 'Entrar a mi panel';\n            return;\n          }\n          localStorage.setItem('mb_token', data.token);\n          if (data.refresh_token) localStorage.setItem('mb_refresh_token', data.refresh_token);\n          localStorage.setItem('mb_tipo', data.tipo);\n          localStorage.setItem('mb_nombre', data.nombre);\n          localStorage.setItem('mb_email', data.email);\n          if (rememberMe) {\n            localStorage.setItem('mb_remember', '1');\n          } else {\n            localStorage.removeItem('mb_remember');\n          }\n          window.location.href = data.team_gym_id ? '/equipo/inicio' : '/dashboard';\n        } else {\n          errorMsg.textContent = data.detail || 'Email o contraseña incorrectos. Inténtalo de nuevo.';\n          errorMsg.style.display = 'block';\n        }\n      } catch (err) {\n        errorMsg.textContent = 'Sin conexión. Verifica tu internet e inténtalo de nuevo.';\n        errorMsg.style.display = 'block';\n      } finally {\n        btn.disabled = false;\n        btn.textContent = 'Entrar a mi panel';\n      }\n    });\n\n    // Dynamic month in preview\n    const pm = document.getElementById('preview-month');\n    if (pm) {\n      const d = new Date();\n      const meses = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];\n      pm.textContent = meses[d.getMonth()] + ' ' + d.getFullYear();\n    }\n\n    // ── Google Sign-In ──\n    (function() {\n      const GOOGLE_CLIENT_ID = '{{ google_client_id }}';\n      const container = document.getElementById('googleBtnContainer');\n      const errorMsg = document.getElementById('googleErrorMsg');\n\n      if (!GOOGLE_CLIENT_ID) {\n        container.innerHTML = '<button type=\"button\" class=\"btn-google\" disabled style=\"opacity:.5;cursor:not-allowed;\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 48 48\"><path fill=\"#EA4335\" d=\"M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z\"/><path fill=\"#4285F4\" d=\"M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z\"/><path fill=\"#FBBC05\" d=\"M10.53 28.59a14.5 14.5 0 0 1 0-9.18l-7.98-6.19a24.01 24.01 0 0 0 0 21.56l7.98-6.19z\"/><path fill=\"#34A853\" d=\"M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z\"/></svg> Google no configurado</button>';\n      } else {\n        const gsiScript = document.createElement('script');\n        gsiScript.src = 'https://accounts.google.com/gsi/client';\n        gsiScript.async = true;\n        gsiScript.defer = true;\n        gsiScript.nonce = '{{ request.state.csp_nonce }}';\n        gsiScript.onload = function() {\n          google.accounts.id.initialize({\n            client_id: GOOGLE_CLIENT_ID,\n            callback: handleGoogleCredential,\n            ux_mode: 'popup',\n          });\n          google.accounts.id.renderButton(container, {\n            theme: 'filled_black',\n            size: 'large',\n            shape: 'rectangular',\n            text: 'continue_with',\n            width: container.offsetWidth || 340,\n            locale: 'es',\n          });\n        };\n        document.head.appendChild(gsiScript);\n      }\n\n      async function handleGoogleCredential(response) {\n        errorMsg.style.display = 'none';\n\n        try {\n          const res = await fetch('/api/auth/google', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({ credential: response.credential, tipo: 'gym' }),\n          });\n          const data = await res.json();\n\n          if (res.ok) {\n            if (data.tipo !== 'gym' && !data.team_gym_id) {\n              errorMsg.textContent = 'Esta cuenta no tiene acceso de gimnasio. ¿Eres miembro? Ingresa desde el portal de usuarios.';\n              errorMsg.style.display = 'block';\n              return;\n            }\n            localStorage.setItem('mb_token', data.token);\n            if (data.refresh_token) localStorage.setItem('mb_refresh_token', data.refresh_token);\n            localStorage.setItem('mb_tipo', data.tipo);\n            localStorage.setItem('mb_nombre', data.nombre);\n            localStorage.setItem('mb_email', data.email);\n            window.location.href = data.team_gym_id ? '/equipo/inicio' : '/dashboard';\n          } else {\n            errorMsg.textContent = data.detail || 'No pudimos conectar con Google. Inténtalo de nuevo.';\n            errorMsg.style.display = 'block';\n          }\n        } catch (err) {\n          errorMsg.textContent = 'Sin conexión al verificar con Google. Inténtalo de nuevo.';\n          errorMsg.style.display = 'block';\n        }\n      }\n    })();\n  "
    }
  ]
}
