with psycopg2.connect(configuration['METODOBASE_TEST_MIGRATOR_URL'].replace('postgresql+psycopg2://','postgresql://',1))as c,c.cursor()as cursor:
    cursor.execute('SET TRANSACTION READ ONLY');cursor.execute('SELECT count(*)FROM pg_database WHERE datname=%s',(resource['owned_database'],));absent=cursor.fetchone()[0]==0
