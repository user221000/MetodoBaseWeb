def processes(filter_value):
    command="Get-CimInstance Win32_Process -Filter '"+filter_value+"' | Select-Object ProcessId,ParentProcessId,ExecutablePath,CommandLine,@{Name='Created';Expression={$_.CreationDate.ToUniversalTime().ToString('o')}} | ConvertTo-Json -Depth 4 -Compress"
    r=subprocess.run(['powershell','-NoProfile','-NonInteractive','-Command',command],capture_output=True,text=True,encoding='utf8',errors='replace',timeout=15);assert r.returncode==0
    value=json.loads(r.stdout)if r.stdout.strip()else[];return value if isinstance(value,list)else[value]
fingerprint=lambda rows:sorted([r['ProcessId'],r['ParentProcessId'],r['Created'],Path(r['ExecutablePath']).name if r.get('ExecutablePath')else None]for r in rows)
def listener8776():
    r=subprocess.run(['powershell','-NoProfile','-NonInteractive','-Command','@(Get-NetTCPConnection -State Listen -LocalPort 8776 -ErrorAction SilentlyContinue|Select-Object -ExpandProperty OwningProcess -Unique)|ConvertTo-Json -Compress'],capture_output=True,text=True,timeout=15);assert r.returncode==0
    pids=json.loads(r.stdout)if r.stdout.strip()else[];pids=[pids]if isinstance(pids,int)else pids
    return fingerprint(processes(' OR '.join('ProcessId='+str(n)for n in pids)))if pids else[]
foreign=processes('Name="chrome.exe"');foreign_keys={(r['ProcessId'],r['Created'])for r in foreign};foreign_listener=listener8776();save('foreign-Chrome-before.json',fingerprint(foreign));save('foreign-listener8776-before.json',foreign_listener)
with socket.socket()as p:assert p.connect_ex(('127.0.0.1',8800))!=0
env=environment(True);env.update(PYTHONPATH=str(ROOT),NODE_PATH=str(MODULES),CHROME_PATH=str(CHROME),R24_PRIVATE=str(RUN),R24_BROWSER_OUTPUT=str(RUN/'browser'))
configuration=json.loads(PRIVATE.read_text(encoding='utf-8-sig'));config=RUN/'pg-config.private.json';config.write_bytes((json.dumps({k:configuration[k]for k in ['METODOBASE_TEST_MIGRATOR_URL','METODOBASE_TEST_POSTGRES_URL','METODOBASE_TEST_PG_BIN']})+'\n').encode());assert not config.read_bytes().startswith(b'\xef\xbb\xbf');config_SHA=sha(config.read_bytes())
known={};rejected=[];fixture=None;node=None;fixture_exit=None;node_exit=None;error=None;started=datetime.now(timezone.utc).isoformat();deadline=time.monotonic()+420
instant=lambda value:datetime.fromisoformat(value.replace('Z','+00:00'))
def register(proc,script):
    rows=processes('ProcessId='+str(proc.pid));assert len(rows)==1 and script in(rows[0].get('CommandLine')or'');r=rows[0];known[(r['ProcessId'],r['Created'])]=r
def observe():
    if not known:return
    # Parent numeric ID is usable only while that exact birth generation is live.
    live=processes(' OR '.join('ProcessId='+str(pid)for pid,_birth in known));active={r['ProcessId']:r for r in live if(r['ProcessId'],r['Created'])in known}
    if not active:return
    children=processes(' OR '.join('ParentProcessId='+str(pid)for pid in active))
    for r in children:
        parent=active.get(r['ParentProcessId'])
        if parent is None or instant(r['Created'])<instant(parent['Created']):
            rejected.append({'child':fingerprint([r]),'parent_generation':fingerprint([parent])if parent else None,'reason':'Child predates registered parent generation or parent generation not live'});continue
        known[(r['ProcessId'],r['Created'])]=r
    (RUN/'owned-process-observation.private.json').write_text(json.dumps(list(known.values()),indent=2)+'\n')
try:
    with (RUN/'fixture.stdout.raw.log').open('xb')as stdout,(RUN/'fixture.stderr.raw.log').open('xb')as stderr:
        fixture=subprocess.Popen([sys.executable,'-X','utf8','-B','tests/e2e/daily_plan_server.py','--private',str(RUN),'--config',str(config)],cwd=ROOT,env=env,stdout=stdout,stderr=stderr);register(fixture,'daily_plan_server.py');print(json.dumps({'phase':'R24-fixture-started','port':8800,'manager_pid':fixture.pid,'head':HEAD}),flush=True)
        while time.monotonic()<deadline:
            observe();assert fixture.poll()is None,'Own fixture exited before startup'
            if (RUN/'startup.json').exists():
                startup=json.loads((RUN/'startup.json').read_bytes());assert startup['runtime_revision']=='20261019_personal_history_index'and startup['model_tables']==29
                assert startup['origin']=='http://127.0.0.1:8800'
                assert all(sha((ROOT/n).read_bytes())==h for n,h in startup['sources'].items())
                actual=processes('ProcessId='+str(startup['pid']));assert len(actual)==1 and(actual[0]['ProcessId'],actual[0]['Created'])in known
                assert str(RUN)in(actual[0].get('CommandLine')or'')and'daily_plan_server.py'in actual[0]['CommandLine']
                witness=subprocess.run([sys.executable,'-X','utf8','-B',str(TEMP/'r24_physical_witness.py'),str(ROOT),str(RUN),str(RUN/'physical-witness.json')],env=env,cwd=ROOT,capture_output=True,timeout=30)
                (RUN/'witness.stdout.log').write_bytes(witness.stdout);(RUN/'witness.stderr.log').write_bytes(witness.stderr);assert witness.returncode==0
                break
            time.sleep(.2)
        else:raise AssertionError('Own fixture startup deadline')
        print(json.dumps({'phase':'R24-real30-ready','schema':30,'model_tables':29,'port':8800}),flush=True)
        with (RUN/'browser.stdout.raw.log').open('xb')as stdout,(RUN/'browser.stderr.raw.log').open('xb')as stderr:
            node=subprocess.Popen([str(NODE),'tests/e2e/daily_plan_browser.cjs'],cwd=ROOT,env=env,stdout=stdout,stderr=stderr);register(node,'daily_plan_browser.cjs')
            while node.poll()is None:observe();assert time.monotonic()<deadline,'Own browser deadline';time.sleep(.2)
            node_exit=node.wait()
except Exception as exc:error={'class':type(exc).__name__,'message':str(exc)}
finally:
    (RUN/'stop').write_bytes(b'Own cooperative stop\n')
    if fixture is not None:fixture_exit=fixture.wait(timeout=45)
    observe()
