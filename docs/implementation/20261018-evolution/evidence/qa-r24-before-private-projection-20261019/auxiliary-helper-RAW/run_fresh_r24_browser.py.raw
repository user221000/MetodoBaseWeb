def photo():return {'head':HEAD,'sources':{n:sha((ROOT/n).read_bytes())for n in names},'review_tools':{p.relative_to(OUTBASE/'review-tools').as_posix():sha(p.read_bytes())for p in (OUTBASE/'review-tools').rglob('*')if p.is_file()},'launcher_sha256':sha(Path(__file__).read_bytes()),'physical_witness_helper_sha256':sha((TEMP/'r24_physical_witness.py').read_bytes()),'packages':sorted([d.metadata['Name'],d.version]for d in importlib.metadata.distributions()),'node_modules':{n:sha((MODULES/n).read_bytes())for n in module_names},'binaries':{'Node':sha(NODE.read_bytes()),'Chrome':sha(CHROME.read_bytes())},'private_config_SHA256':sha(PRIVATE.read_bytes())}
