cases=ET.parse(phase/'junit.xml').findall('.//testcase');failures=[{'name':c.get('name'),'classname':c.get('classname')}for c in cases if any(c.find(t)is not None for t in ['failure','error','skipped'])]
outputs=[publish(p,'own-http-v2-'+p.relative_to(phase).as_posix().replace('/','--'))for p in sorted(phase.rglob('*'))if p.is_file()]
