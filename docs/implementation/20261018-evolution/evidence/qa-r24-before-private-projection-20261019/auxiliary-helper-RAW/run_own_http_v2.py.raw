phase=TEMP/'own-http-v2-v2';phase.mkdir();origin=phase/'origin';origin.mkdir();test=TEMP/'test_r24_own_http_v2.py';own_sha=sha(test.read_bytes());before=photo('own-http-v2-before');env=environment();env['QA_HISTORY30_MODULE_ORIGIN_OUT']=str(origin)
command=[str(PYTHON),'-X','utf8','-B','tests/run_isolated.py','-p','qa_r24_origin','--rootdir='+str(ROOT),'--import-mode=importlib',str(test),'-q','--tb=short','--junitxml='+str(phase/'junit.xml')]
