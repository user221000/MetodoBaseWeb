print(json.dumps({'mode':'own-http','exit':result.returncode,'total':len(cases),'passed':len(cases)-len(failures),'nonpass':failures,'sources':before['source_count'],'stable':True}));assert result.returncode==0 and len(cases)==6 and not failures
