const fs=require('node:fs'),vm=require('node:vm'),assert=require('node:assert/strict');
const ROOT='F:/mb-r24-qa-20261019',c={window:{}};vm.createContext(c);vm.runInContext(fs.readFileSync(ROOT+'/web/static/js/plan-diario-datos.js','utf8'),c);const m=c.window.PlanDayData,results=[],clone=x=>JSON.parse(JSON.stringify(x));
function test(name,body){try{body();results.push({case:name,passed:true});}catch(e){results.push({case:name,passed:false,error:e.stack});}}
const f=(id,g)=>({alimento:id,gramos:g,equivalencia:'1 taza textual'});
const meal=()=>({tipo_plan:'opciones',proteinas:{opciones:[f('huevo',.125),f('pollo',.25)]},carbohidratos:{opciones:[f('arroz',1.5)]},grasas:{opciones:[f('aceite',2.25)]},vegetales:[f('brocoli',12.5)]});
const plan=()=>Object.fromEntries(m.names.map(n=>[n,meal()]));
test('62 inclusive days across year uses exact selected grams once per day',()=>{const source=plan(),p=m.menu(source,['huevo']),rows=m.select(p,{desayuno:{proteinas:0}}),out=m.shopping(rows,'2025-12-31','2026-03-02');assert.equal(out.days,62);assert.equal(out.items.length,1);assert.equal(out.items[0].grams,7.75);assert.equal(out.kind,'unregistered_shopping_draft');assert.equal(source.desayuno.proteinas.opciones[0].gramos,.125);});
test('Selection across three groups and explicit vegetables contains only chosen quantities',()=>{const rows=m.select(m.menu(plan(),['pollo','arroz','aceite','brocoli']),{comida:{proteinas:1,carbohidratos:0,grasas:0,include_vegetables:true}});assert.deepEqual(clone(rows.map(x=>[x.food_id,x.grams])),[['pollo',.25],['arroz',1.5],['aceite',2.25],['brocoli',12.5]]);assert.ok(rows.every(x=>x.origin.meal==='comida'));});
test('Group selection cannot cross group bounds or use coerced indices',()=>{const p=m.menu(plan());for(const bad of[-1,.5,true,'0',Number.MAX_SAFE_INTEGER])assert.throws(()=>m.select(p,{cena:{proteinas:bad}}));assert.throws(()=>m.select(p,{cena:{grasas:1}}));});
test('Empty explicit choices create an empty draft without zero-value foods',()=>{const rows=m.select(m.menu(plan()),{}),out=m.shopping(rows,'2026-10-19','2026-10-19');assert.equal(rows.length,0);assert.equal(out.days,1);assert.equal(out.items.length,0);});
test('Confirmed catalog identity is case-sensitive and never reconciles label lookalikes',()=>{const p=plan();p.desayuno.proteinas.opciones=[f('Huevo',.25)];const rows=m.select(m.menu(p,['huevo']),{desayuno:{proteinas:0},cena:{proteinas:0}}),out=m.shopping(rows,'2026-10-19','2026-10-19');assert.equal(out.items.length,2);assert.equal(out.items[0].food_id,null);assert.equal(out.items[1].food_id,'huevo');});
test('Only grams unit enters shopping; mg and household measures reject atomically',()=>{for(const unit of['mg','kg','taza','G',null])assert.throws(()=>m.shopping([{food_id:'huevo',label:'huevo',grams:100,unit}],'2026-10-19','2026-10-19'));});
test('A malformed meal remains unavailable without silently dropping its requested choice',()=>{const p=plan();p.desayuno.proteinas.opciones[0].gramos='20';const menu=m.menu(p);assert.equal(menu[0].available,false);assert.equal(menu[1].available,true);assert.throws(()=>m.select(menu,{desayuno:{proteinas:0}}));assert.equal(m.select(menu,{cena:{proteinas:0}}).length,1);});
test('Fixed source cannot mix a fixed confirmation with group selection',()=>{const p=m.menu({desayuno:{alimentos:{huevo:.25}}},['huevo']);assert.throws(()=>m.select(p,{desayuno:{include_fixed_menu:true,proteinas:0}}));assert.equal(m.select(p,{desayuno:{include_fixed_menu:false}}).length,0);assert.equal(m.select(p,{desayuno:{include_fixed_menu:true}})[0].grams,.25);});
test('Recorded amounts include persisted uncompleted snapshots and never consult displayed plan choices',()=>{const calendar={days:[{local_date:'2026-10-18',meals:{cena:{completed:false,foods:[{food_id:'huevo',grams:.25}]}}},{local_date:'2026-10-19',meals:{desayuno:{completed:true,foods:[{food_id:'huevo',grams:.125}]}}}]};const result=m.recorded(calendar);assert.equal(result.recordedMeals,2);assert.equal(result.items[0].grams,.375);assert.equal(result.kind,'recorded_consumption');});
test('Detached output mutation cannot change source selections or their origin',()=>{const input=plan(),menu=m.menu(input,['huevo']),rows=m.select(menu,{desayuno:{proteinas:0}}),draft=m.shopping(rows,'2026-10-19','2026-10-20');rows[0].origin.meal='forged';draft.items[0].grams=999;assert.equal(menu[0].groups.proteinas[0].origin.meal,'desayuno');assert.equal(input.desayuno.proteinas.opciones[0].gramos,.125);});
test('Recorded calendar must be ordered with unique real dates and known meals',()=>{for(const days of[[{local_date:'2026-10-19',meals:{}},{local_date:'2026-10-18',meals:{}}],[{local_date:'2026-10-19',meals:{}},{local_date:'2026-10-19',meals:{}}],[{local_date:'2026-10-19',meals:{snack:{foods:[]}}}]])assert.throws(()=>m.recorded({days}));});
console.log(JSON.stringify({scope:'Independent source quantity/range/selection cases; pure VM, no browser/HTTP.',total:results.length,passed:results.filter(r=>r.passed).length,results},null,2));if(results.some(r=>!r.passed))process.exitCode=1;
