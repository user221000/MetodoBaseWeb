  "semantics": {
    "meals": "Only explicitly registered consumption; opening plan/selection draft never saves.",
    "totals": "Sum all registered snapshots regardless of completed; empty is four zero values. Completing toggles no foods/macros.",
    "replacement": "New meal replaces only that meal and resets only its completed=False. Other meals and water unchanged.",
    "empty_selection": "Explicit selection with no groups and include_vegetables=False produces foods=[], totals=0 and a source snapshot.",
    "versions": "No automatic retry/merge on409. Reload day, preserve user draft separately, request explicit retry against observed version.",
    "uncertain": "503 diary_save_unconfirmed means reload before retry. Commit may have succeeded. GET is authoritative; no idempotency-key claim."
  },
