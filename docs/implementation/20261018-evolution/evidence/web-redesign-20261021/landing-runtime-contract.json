{
  "base": "713bd3d39a37ed6bef0f344a67a6bfbfccbaa4b3",
  "jinja": [
    "{{ landing_style_version }}",
    "{% for group in example.groups %}",
    "{{ group.option.alimento | replace('_', ' ') | capitalize }}",
    "{{ group.option.gramos }}",
    "{% endfor %}",
    "{% set labels = {'free':'Free','standard':'Standard','gym_comercial':'Gym','clinica':'Clínica'} %}",
    "{% for key, plan in business_plans.items() %}",
    "{{ key }}",
    "{{ labels.get(key, key) }}",
    "{{ plan.precio_centavos }}",
    "{{ plan.moneda }}",
    "{{ plan.periodo }}",
    "{{ '%.2f' | format(plan.precio_centavos / 100) }}",
    "{{ plan.moneda }}",
    "{{ 'mes' if plan.periodo == 'month' else plan.periodo }}",
    "{{ plan.max_clientes }}",
    "{% if plan.max_clientes %}",
    "{{ plan.max_clientes }}",
    "{% else %}",
    "{% endif %}",
    "{{ plan.max_registros_diarios }}",
    "{% if plan.max_registros_diarios %}",
    "{{ plan.max_registros_diarios }}",
    "{% else %}",
    "{% endif %}",
    "{{ plan.max_planes_por_cliente_dia }}",
    "{% if plan.max_planes_por_cliente_dia %}",
    "{{ plan.max_planes_por_cliente_dia }}",
    "{% else %}",
    "{% endif %}",
    "{{ plan.max_planes_diarios }}",
    "{% if plan.max_planes_diarios %}",
    "{{ plan.max_planes_diarios }}",
    "{% else %}",
    "{% endif %}",
    "{{ plan.max_planes_mes }}",
    "{% if plan.max_planes_mes %}",
    "{{ plan.max_planes_mes }}",
    "{% else %}",
    "{% endif %}",
    "{% if plan.multi_usuario %}",
    "{% else %}",
    "{% endif %}",
    "{% endfor %}",
    "{% for key, plan in individual_plans.items() %}",
    "{{ key }}",
    "{{ 'Starter' if key == 'starter' else 'Pro' }}",
    "{{ plan.precio_centavos }}",
    "{{ plan.moneda }}",
    "{{ plan.periodo }}",
    "{{ '%.2f' | format(plan.precio_centavos / 100) }}",
    "{{ plan.moneda }}",
    "{{ 'mes' if plan.periodo == 'month' else plan.periodo }}",
    "{{ plan.max_planes_mes }}",
    "{{ plan.max_planes_mes }}",
    "{% endfor %}"
  ],
  "hrefs": [
    "/static/css/landing.css?v={{ landing_style_version }}",
    "#contenido",
    "/",
    "/login-gym",
    "/login-usuario",
    "/registro?tipo=gym",
    "/registro?tipo=usuario",
    "#planes-negocio",
    "#planes-personales",
    "/registro?tipo=gym",
    "/registro?tipo=usuario",
    "/login-usuario",
    "/login-gym",
    "/login-usuario",
    "#datos-personales"
  ]
}
