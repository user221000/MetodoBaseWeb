95a196ec5766ad1428f8f6bf32b50e","filename":"expat/tests/alloc_tests.c","status":"modified","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/libexpat/libexpat/blob/209801d7fbaf07ab74bae8cb32dd2ab9e5846118/expat%2Ftests%2Falloc_tests.c","raw_url":"https://github.com/libexpat/libexpat/raw/209801d7fbaf07ab74bae8cb32dd2ab9e5846118/expat%2Ftests%2Falloc_tests.c","contents_url":"https://api.github.com/repos/libexpat/libexpat/contents/expat%2Ftests%2Falloc_tests.c?ref=209801d7fbaf07ab74bae8cb32dd2ab9e5846118","patch":"@@ -2136,6 +2136,10 @@ START_TEST(test_alloc_tracker_size_recorded) {\n     assert_true(ptr != NULL);\n     assert_true(sizeRecordedFor(ptr) == 10);\n \n+    assert_true(expat_realloc(parser, ptr, SIZE_MAX, -1) == NULL);\n+\n+    assert_true(sizeRecordedFor(ptr) == 10); // i.e. unchanged\n+\n     assert_true(expat_realloc(parser, ptr, SIZE_MAX / 2, -1) == NULL);\n \n     assert_true(sizeRecordedFor(ptr) == 10); // i.e. unchanged"}]}