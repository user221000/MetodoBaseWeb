"""Behavior regressions for current identity, revocation and closed RBAC.

The database is synthetic SQLite in memory; no configured database is opened.
Provider login is tested using a fake transport, never Google credentials.
"""
import time
import uuid
from unittest.mock import AsyncMock

import pytest
from fastapi import FastAPI
from fastapi.testclient import TestClient
from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker
from sqlalchemy.pool import StaticPool


@pytest.fixture
def identity_db(monkeypatch):
    from web import auth
    from web.database import engine as database
    from web.database.models import Base, Usuario, UserRole

    engine = create_engine("sqlite://", connect_args={"check_same_thread": False}, poolclass=StaticPool)
    Base.metadata.create_all(engine)
    factory = sessionmaker(bind=engine, expire_on_commit=False)
    monkeypatch.setattr(auth, "_get_session", factory)
    monkeypatch.setattr(auth, "SECRET_KEY", "synthetic-security-test-key-with-no-external-use")
    monkeypatch.setattr(database, "_engine", engine)
    monkeypatch.setattr(database, "_SessionLocal", factory)
    password = "SyntheticPassword123!"
    owner_id, member_id = str(uuid.uuid4()), str(uuid.uuid4())
    with factory() as db:
        db.add(Usuario(id=owner_id, email=f"{owner_id}@example.invalid", password_hash=auth.hash_password(password), nombre="Owner", tipo="gym", role=UserRole.OWNER, activo=True))
        db.commit()
        db.add(Usuario(id=member_id, email=f"{member_id}@example.invalid", password_hash=auth.hash_password(password), nombre="Member", tipo="usuario", role=UserRole.NUTRIOLOGO, team_gym_id=owner_id, activo=True))
        db.commit()
    yield factory, owner_id, member_id, password
    engine.dispose()


def principal(factory, user_id):
    from web.database.models import Usuario
    with factory() as db:
        user = db.get(Usuario, user_id)
        return {"id": user.id, "email": user.email, "nombre": user.nombre, "apellido": user.apellido, "tipo": user.tipo, "role": user.role.value, "team_gym_id": user.team_gym_id, "session_version": getattr(user, "session_version", 0)}


def auth_client(monkeypatch):
    from web.routes import auth as routes
    from web.services import auth_audit
    monkeypatch.setattr(auth_audit, "log_auth_event_from_request", AsyncMock())
    app = FastAPI()
    app.include_router(routes.router, prefix="/api")
    return TestClient(app)


@pytest.mark.parametrize("role", ["owner", "admin", "nutriologo", "viewer"])
def test_unknown_permission_is_denied_even_to_owner(role):
    from web.services.permissions import has_permission
    assert not has_permission({"id": "gym-a", "tipo": "gym", "role": role}, "new_unregistered_action", "cliente", "gym-b")


@pytest.mark.parametrize("tipo", ["gym", "usuario"])
def test_invalid_role_never_becomes_owner(tipo):
    from web.services.permissions import has_permission
    assert not has_permission({"id": "gym-a", "tipo": tipo, "role": "corrupt_role"}, "create", "cliente")


def test_password_and_refresh_preserve_persisted_membership(identity_db):
    from web import auth
    factory, owner_id, member_id, password = identity_db
    user = auth.verificar_credenciales(principal(factory, member_id)["email"], password)
    assert user["role"] == "nutriologo"
    assert user["team_gym_id"] == owner_id
    tokens = auth.crear_token_pair(user)
    rotated = auth.rotar_refresh_token(tokens["refresh_token"])
    current = auth.verificar_token(rotated["access_token"])
    assert current["role"] == "nutriologo"
    assert current["team_gym_id"] == owner_id


def test_role_downgrade_changes_existing_access_immediately(identity_db):
    from web import auth
    from web.database.models import Usuario, UserRole
    factory, _, member_id, _ = identity_db
    token = auth.crear_access_token(principal(factory, member_id))
    with factory() as db:
        db.get(Usuario, member_id).role = UserRole.VIEWER
        db.commit()
    assert auth.verificar_token(token)["role"] == "viewer"


@pytest.mark.parametrize("change", ["deactivate", "delete", "remove_membership"])
def test_removed_user_or_membership_cannot_use_old_access(identity_db, change):
    from web import auth
    from web.database.models import Usuario
    factory, _, member_id, _ = identity_db
    token = auth.crear_access_token(principal(factory, member_id))
    with factory() as db:
        user = db.get(Usuario, member_id)
        if change == "deactivate":
            user.activo = False
        elif change == "delete":
            db.delete(user)
        else:
            user.team_gym_id = None
        db.commit()
    assert auth.verificar_token(token) is None


def test_logout_revokes_access_and_refresh(identity_db, monkeypatch):
    from web import auth
    factory, owner_id, _, _ = identity_db
    pair = auth.crear_token_pair(principal(factory, owner_id))
    response = auth_client(monkeypatch).post("/api/auth/logout", headers={"Authorization": f"Bearer {pair['access_token']}"})
    assert response.status_code == 200
    assert auth.verificar_token(pair["access_token"]) is None
    assert auth.verificar_refresh_token(pair["refresh_token"]) is None


def test_remember_me_never_extends_access_to_days(identity_db):
    from web import auth
    factory, owner_id, _, _ = identity_db
    token = auth.crear_access_token(principal(factory, owner_id), remember_me=True)
    payload = auth._decode_token(token)
    assert 0 < payload["exp"] - time.time() <= auth.ACCESS_TOKEN_EXPIRE_MINUTES * 60


def test_public_emergency_maintenance_is_absent(identity_db, monkeypatch):
    from web import auth
    factory, owner_id, _, _ = identity_db
    response = auth_client(monkeypatch).post("/api/admin/fix-user-tipo", json={"email": principal(factory, owner_id)["email"], "nuevo_tipo": "usuario", "admin_secret": auth.SECRET_KEY})
    assert response.status_code == 404
    assert principal(factory, owner_id)["tipo"] == "gym"


def test_google_uses_same_member_identity(identity_db, monkeypatch):
    from types import SimpleNamespace
    from web import auth
    from config import settings
    factory, owner_id, member_id, _ = identity_db
    user = principal(factory, member_id)
    monkeypatch.setattr(settings.get_settings(), "GOOGLE_CLIENT_ID", "synthetic-client-id")

    class FakeGoogleClient:
        def __init__(self, **kwargs):
            pass
        async def __aenter__(self):
            return self
        async def __aexit__(self, *args):
            pass
        async def get(self, url, **kwargs):
            return SimpleNamespace(status_code=200, json=lambda: {"aud": "synthetic-client-id", "email_verified": "true", "email": user["email"]})

    monkeypatch.setattr("httpx.AsyncClient", FakeGoogleClient)
    response = auth_client(monkeypatch).post("/api/auth/google", json={"credential": "synthetic-only", "tipo": "gym"})
    assert response.status_code == 200
    assert response.json()["role"] == "nutriologo"
    assert response.json()["team_gym_id"] == owner_id
    identity = auth.verificar_token(response.json()["token"])
    assert identity["role"] == "nutriologo"
    assert identity["team_gym_id"] == owner_id


def test_disabled_google_account_is_not_recreated(identity_db, monkeypatch):
    from types import SimpleNamespace
    from web.database.models import Usuario
    from config import settings
    factory, _, member_id, _ = identity_db
    user = principal(factory, member_id)
    with factory() as db:
        db.get(Usuario, member_id).activo = False
        db.commit()
    monkeypatch.setattr(settings.get_settings(), "GOOGLE_CLIENT_ID", "synthetic-client-id")

    class FakeGoogleClient:
        def __init__(self, **kwargs):
            pass
        async def __aenter__(self):
            return self
        async def __aexit__(self, *args):
            pass
        async def get(self, url, **kwargs):
            return SimpleNamespace(status_code=200, json=lambda: {"aud": "synthetic-client-id", "email_verified": "true", "email": user["email"]})

    monkeypatch.setattr("httpx.AsyncClient", FakeGoogleClient)
    response = auth_client(monkeypatch).post("/api/auth/google", json={"credential": "synthetic-only"})
    assert response.status_code == 401
    with factory() as db:
        assert db.query(Usuario).filter(Usuario.email == user["email"]).count() == 1


def test_logout_during_rotation_cannot_resurrect_session(identity_db, monkeypatch):
    from web import auth
    factory, owner_id, _, _ = identity_db
    pair = auth.crear_token_pair(principal(factory, owner_id))
    original_lookup = auth._current_token_identity
    lookups = 0

    def logout_before_second_lookup(payload):
        nonlocal lookups
        lookups += 1
        if lookups == 2:
            auth.revocar_refresh_tokens_usuario(owner_id)
        return original_lookup(payload)

    monkeypatch.setattr(auth, "_current_token_identity", logout_before_second_lookup)
    assert auth.rotar_refresh_token(pair["refresh_token"]) is None


def test_legacy_access_epoch_zero_is_revoked_by_logout(identity_db):
    from web import auth
    factory, owner_id, _, _ = identity_db
    legacy = {**principal(factory, owner_id), "exp": time.time() + 300, "type": "access"}
    token = auth._make_token(legacy)
    assert auth.verificar_token(token) is not None
    auth.revocar_refresh_tokens_usuario(owner_id)
    assert auth.verificar_token(token) is None


@pytest.mark.parametrize("expiry", [float("nan"), float("inf"), "999999999999", True])
def test_invalid_expiry_is_rejected(identity_db, expiry):
    from web import auth
    factory, owner_id, _, _ = identity_db
    token = auth._make_token({**principal(factory, owner_id), "exp": expiry, "type": "access"})
    assert auth.verificar_token(token) is None


def test_viewer_cannot_create_client(identity_db):
    from web import auth
    from web.database.models import Usuario, UserRole, Cliente
    from web.routes import clientes
    factory, owner_id, member_id, _ = identity_db
    with factory() as db:
        db.get(Usuario, member_id).role = UserRole.VIEWER
        db.commit()
    token = auth.crear_access_token(principal(factory, member_id))
    app = FastAPI()
    app.include_router(clientes.router, prefix="/api")
    response = TestClient(app).post("/api/clientes", headers={"Authorization": f"Bearer {token}"}, json={"nombre": "Synthetic", "edad": 30, "peso_kg": 70, "estatura_cm": 170, "sexo": "M", "objetivo": "mantenimiento", "nivel_actividad": "moderada"})
    assert response.status_code == 403
    with factory() as db:
        assert db.query(Cliente).filter(Cliente.gym_id == owner_id).count() == 0


@pytest.mark.parametrize("plan_name", ["free", "unknown_future_plan"])
def test_safety_exclusions_can_be_created_and_updated_without_paid_feature(identity_db, plan_name):
    import json
    from fastapi import Depends
    from web import auth
    from web.auth_deps import get_usuario_actual
    from web.database.models import Cliente
    from web.routes import clientes
    from web.subscription_guard import require_active_subscription
    factory, owner_id, _, _ = identity_db
    token = auth.crear_access_token(principal(factory, owner_id))

    def subscription_identity(usuario=Depends(get_usuario_actual)):
        return {**usuario, "subscription": {"plan": plan_name, "status": "free", "max_clientes": 10}}

    app = FastAPI()
    app.include_router(clientes.router, prefix="/api")
    # Only the resolved billing tier is supplied; auth, quota, DTO and repository
    # remain real. Unknown tiers still use conservative Free quotas.
    app.dependency_overrides[require_active_subscription] = subscription_identity
    client = TestClient(app, headers={"Authorization": f"Bearer {token}"})
    response = client.post("/api/clientes", json={"nombre": "Synthetic", "edad": 30, "peso_kg": 70, "estatura_cm": 170, "sexo": "M", "objetivo": "mantenimiento", "nivel_actividad": "moderada", "alimentos_excluidos": ["huevo"]})
    assert response.status_code == 201
    client_id = response.json()["id_cliente"]
    response = client.put(f"/api/clientes/{client_id}", json={"alimentos_excluidos": ["avena"]})
    assert response.status_code == 200
    with factory() as db:
        saved = db.query(Cliente).filter(Cliente.id_cliente == client_id, Cliente.gym_id == owner_id).one()
        assert json.loads(saved.alimentos_excluidos) == ["avena"]
