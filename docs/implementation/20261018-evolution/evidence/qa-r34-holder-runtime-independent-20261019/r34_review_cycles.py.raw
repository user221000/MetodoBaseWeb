import json,hashlib,collections
from pathlib import Path
out=Path('F:/MetodoBaseWeb-execution-20261018/docs/implementation/20261018-evolution/evidence/qa-r34-holder-runtime-independent-20261019');events=json.loads((out/'instrumentation.json').read_text())['events'];analysis=json.loads((out/'holder-analysis.json').read_text());lookup={e['sequence']:e for e in events};cycles=[]
for row in analysis['rows']:
    first=row['holder_checkout_sequence'];last=row['holder_checkin_sequence'];tx=[e for e in events if first<e['sequence']<last and e['event']=='Session_transaction_begin'and e['connection']=='C1'];assert len(tx)==1
    txn=tx[0];ctor=next(e for e in events if e['event']=='Session_constructed'and e.get('session')==txn['session']);close=next(e for e in events if e['event']=='Session_close_start'and e.get('session')==txn['session']);done=next(e for e in events if e['event']=='Session_close_end'and e.get('session')==txn['session']);queries=[e for e in events if first<e['sequence']<last and e['event']=='query_finished'and e.get('connection')=='C1'];task=lookup[row['start_sequence']]['holders'][0]['checkout_async_task'];cycles.append({'waiter_start_sequence':row['start_sequence'],'checkout_sequence':first,'transaction_begin_sequence':txn['sequence'],'session':txn['session'],'checkin_sequence':last,'close_start_sequence':close['sequence'],'close_end_sequence':done['sequence'],'owner_request':ctor['context']['request'],'owner_path':ctor['context']['path'],'constructor_app_frames':[f for f in ctor['constructor_frames']if f['file'].startswith(('web/','api/'))],'checkout_app_frames':[f for f in lookup[row['start_sequence']]['holders'][0]['checkout_frames']if f['file'].startswith(('web/','api/'))],'last_finished_query_in_checkout_cycle_sequence':queries[-1]['sequence'],'last_query_finished_after_waiter_start_emit':queries[-1]['sequence']>row['start_sequence'],'snapshot_checkout_task':task,'checkin_before_start_emit':row['checkin_preceded_acquire_start_emit']})
(out/'connection-cycle-review.json').write_text(json.dumps({'single_connection_alias':'C1','cyclic_alias_not_unique_checkout_identity':True,'method':'Exact checkout -> next checkin interval on the sole connection, then actual Session_transaction_begin mapping inside that interval. No inference from thread reuse or actor identity. Missing Session at early checkout snapshot is resolved only by its later observed transaction_begin in the same unique checkout cycle.','cycles':cycles},indent=2)+'\n')
for c in cycles:
    if not c['checkin_before_start_emit']:print(json.dumps({k:v for k,v in c.items()if k!='snapshot_checkout_task'}))
