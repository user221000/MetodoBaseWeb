born=native_birth();planned='metodobase_test_r34_holder_'+uuid.uuid4().hex[:12]
def origin_fence():
    checked={}
    for name,module in list(sys.modules.items()):
        if name.split('.')[0]in {'web','api','core','tests'}and getattr(module,'__file__',None):
            origin=Path(module.__file__).resolve()
            if not origin.is_relative_to(ROOT.resolve()):
                save('module-origin-violation-'+str(len(list(OUT.glob('module-origin-violation*'))))+'.json',{'module':name,'file':str(origin)});raise AssertionError('Module origin outside frozen own worktree')
            checked[name]=str(origin.relative_to(ROOT.resolve()))
    return checked

