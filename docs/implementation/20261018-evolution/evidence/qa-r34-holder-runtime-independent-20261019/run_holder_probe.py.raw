    runtime_witness={'engine_constructor':'actual web.database.engine.get_engine -> init_db','DB_POOL_SIZE':1,'DB_MAX_OVERFLOW':0,'pool_size':engine.pool.size(),'max_overflow':engine.pool._max_overflow,'original_runtime_timeout_seconds':30,'diagnostic_timeout_seconds':engine.pool._timeout,'timeout_delta_harness_only':True,'runtime_SessionLocal_bound_to_same_engine':True,'model_tables':29,'actual_tables':physical,'revision':revision,'history_index':index,'restricted_role_flags':list(flags),'database_nonowner':True,'FORCE_RLS_families':families};save('runtime-witness.json',runtime_witness)
