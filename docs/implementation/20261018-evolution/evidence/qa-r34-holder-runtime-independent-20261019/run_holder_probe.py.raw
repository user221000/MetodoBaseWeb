    import httpx,uvicorn
    async def request(client,factory,label,path):
        try:
            response=await client.get('http://127.0.0.1:'+str(PORT)+path,headers={'Authorization':'Bearer '+bearer,'X-QA-R34-Request':label,'X-Request-ID':label},follow_redirects=False)
            row={'factory':factory,'request':label,'path':path,'status':response.status_code,'request_id_present':bool(response.headers.get('x-request-id')),'response_body_recorded':False}
        except Exception as exc:row={'factory':factory,'request':label,'path':path,'transport_exception_class':type(exc).__name__,'response_body_recorded':False}
        request_rows.append(row);return row
    async def exercise(factory):
        async with httpx.AsyncClient(timeout=12,trust_env=False)as client:
            trace.stage='serial-controls'
            for i,path in enumerate(['/api/auth/me','/api/estadisticas','/api/estadisticas/seguimiento']):
                row=await request(client,factory,'r34-'+factory.replace('.','-')+'-serial-'+str(i),path);assert row.get('status')==200,'Serial supported endpoint failed before concurrency'
            trace.stage='natural-overlap2'
            await asyncio.gather(*(request(client,factory,'r34-'+factory.replace('.','-')+'-pair-'+str(i),path)for i,path in enumerate(['/api/auth/me','/api/estadisticas'])))
            trace.stage='natural-overlap3'
            await asyncio.gather(*(request(client,factory,'r34-'+factory.replace('.','-')+'-triple-'+str(i),path)for i,path in enumerate(['/api/auth/me','/api/estadisticas','/api/estadisticas/seguimiento'])))
    for factory in ['web.main_web','api.app']:
        with socket.socket()as p:assert p.connect_ex(('127.0.0.1',PORT))!=0
        trace.factory=factory;trace.stage='factory-startup';application=importlib.import_module(factory).create_app();bearer=crear_access_token(persisted_identity);observed=trace.wrap(application,factory)
        server=uvicorn.Server(uvicorn.Config(observed,host='127.0.0.1',port=PORT,log_level='critical',access_log=False,timeout_graceful_shutdown=8));thread=threading.Thread(target=server.run,name='R34-own-uvicorn-'+factory,daemon=True);thread.start()
        end=time.monotonic()+30
        while not server.started:
            assert thread.is_alive()and time.monotonic()<end,'Own runtime startup failure';time.sleep(.05)
        asyncio.run(exercise(factory));server.should_exit=True;thread.join(15);assert not thread.is_alive();server=None;thread=None
        assert engine.pool.checkedout()==0 and not trace.holders,'Natural batch left an outstanding runtime connection'
        print(json.dumps({'phase':'R34-factory-finished','factory':factory,'requests':8,'pool_checked_out':engine.pool.checkedout(),'acquire_failures_so_far':sum(e['event']=='acquire_failed'for e in trace.events)}),flush=True)
