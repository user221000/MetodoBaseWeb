assert type(pyexpat.expat_CAPI).__name__=='PyCapsule' and repr(pyexpat.expat_CAPI).startswith('<capsule object "pyexpat.expat_CAPI"')
assert sha('/usr/local/include/python3.12/pyexpat.h')=='d3564a35c027eb7a0e4ddbf8659769bf4be61b0c39666c79c555249fa8b0d099'
assert pyexpat.EXPAT_VERSION=='expat_2.8.5'
import xml.etree.ElementTree as ET
xml=b'<root><child>bounded</child></root>';cases=[]
p=pyexpat.ParserCreate();p.Parse(xml[:11],False);p.Parse(xml[11:],True);cases.append('pyexpat_small_chunked')
pyexpat.ParserCreate().ParseFile(io.BytesIO(xml));cases.append('pyexpat_small_file')
assert ET.fromstring(xml).find('child').text=='bounded';cases.append('elementtree_small_fromstring')
assert ET.parse(io.BytesIO(xml)).getroot().tag=='root';cases.append('elementtree_small_file')
class Oversize:
 def __init__(self):self.requests=[]
 def read(self,n):self.requests.append(n);return b'x'*(n+1)
source=Oversize()
try:pyexpat.ParserCreate().ParseFile(source)
except ValueError:pass
else:raise AssertionError('Oversized Python read accepted')
assert source.requests==[2048];cases.append('parsefile_read2049_over_buffer2048_rejected')
try:ET.fromstring(b'<root>')
except ET.ParseError:pass
else:raise AssertionError('Malformed XML accepted')
cases.append('elementtree_small_malformed_rejected')
text='\u00e1\u03a9\U0001f40d';xml=('<r><n>'+text+'</n></r>').encode();chars=[];p=pyexpat.ParserCreate();p.CharacterDataHandler=chars.append
for byte in xml:p.Parse(bytes([byte]),False)
p.Parse(b'',True);assert ''.join(chars)==text;cases.append('pyexpat_utf8_byte_chunks')
assert ET.fromstring(xml).find('n').text==text;cases.append('elementtree_utf8')
xml=b'<r>&amp;&lt;&gt;&#x3A9;</r>';chars=[];p=pyexpat.ParserCreate();p.CharacterDataHandler=chars.append;p.Parse(xml,True)
assert ''.join(chars)=='&<>\u03a9';cases.append('pyexpat_entities')
assert ET.fromstring(xml).text=='&<>\u03a9';cases.append('elementtree_entities')
assert ET.fromstring(b'<r xmlns="urn:bounded"><n/></r>').tag=='{urn:bounded}r';cases.append('elementtree_namespace')
assert len(cases)==11
assert psycopg2.__libpq_version__==extensions.libpq_version()==170011 and ssl.OPENSSL_VERSION.startswith('OpenSSL 3.5.7 ')
native={}
for name,path in {'pyexpat':artifact,'elementtree':elementtree,'psycopg2':Path(psycopg2._psycopg.__file__)}.items():
 parsed=elf(path.read_bytes());assert parsed['machine']==62 and not parsed['rpath'] and not parsed['runpath']
 ldd=subprocess.check_output(['ldd',str(path)],text=True);assert 'not found' not in ldd
 native[name]={'path':str(path),'sha256':sha(path),**parsed,'ldd':ldd,'exports':exports(path.read_bytes())}
assert native['pyexpat']['needed']==['libc.so.6'] and 'libpq.so.5' in native['psycopg2']['needed']
assert not any('.libs/' in str(p) for p in Path(psycopg2.__file__).parent.rglob('*'))
fmt='${binary:Package}\t${Version}\n'
packages=dict(line.split('\t',1) for line in subprocess.check_output(['dpkg-query','-W','-f='+fmt],text=True).splitlines())
def rows(path):return dict(line.split('\t',1) for line in Path(path).read_text().splitlines())
base=rows('/usr/local/share/metodobase/native-runtime/before.tsv');after=rows('/usr/local/share/metodobase/native-runtime/after.tsv')
assert packages==after and all(after.get(n)==v for n,v in base.items())
assert sha(artifact)==prov['artifact_sha256'] and actual_app=={p.relative_to('/app').as_posix():sha(p) for p in Path('/app').rglob('*') if p.is_file()}
from cryptography.hazmat.backends.openssl.backend import backend
report={'status':'PASS_RUNTIME_IMPORT_DIAGNOSTIC_ONLY','scope':'Exact current144R30 image/57 installed dependencies/native/source inspection only; no application startup, PostgreSQL or provider calls',
 'python':sys.version,'uid':os.getuid(),'gid':os.getgid(),'source_files_exact':len(actual_app),'source_hashes':actual_app,'distributions':actual_dists,'imports':imports,
 'runtime_python_metadata_sha256':sha('/usr/local/share/metodobase/runtime-python-metadata.json'),'pip_and_ensurepip_and_bundled_wheels_absent':True,'build_tools_absent':True,
 'native':native,'expat_attestation':prov,'expat_attestation_sha256':sha(att/'build-provenance.json'),'base_identity_files_unchanged':len(base_checks),
 'small_xml_cases':cases,'capi_capsule_name':'pyexpat.expat_CAPI','psycopg2_version':psycopg2.__version__,'libpq_compile':psycopg2.__libpq_version__,'libpq_runtime':extensions.libpq_version(),
 'openssl_system':ssl.OPENSSL_VERSION,'openssl_cryptography_actual':backend.openssl_version_text(),'os_packages':packages,
 'os_package_counts':{'before_native':len(base),'after_native':len(after),'runtime':len(packages)},'native_runtime_additions':{n:v for n,v in after.items() if n not in base},
 'complete_product_acceptance':False,'application_startup_or_migrations_claimed':False,'security_or_OS71_or_SCA_closure_claimed':False}

assert sys.version_info[:3]==(3,12,15) and sysconfig.get_config_var('SOABI')=='cpython-312-x86_64-linux-gnu'
system_dependencies={}
for name in ('libpq.so.5','libssl.so.3','libcrypto.so.3'):
 matches=re.findall(r'^\s*'+re.escape(name)+r' => (/[^\s]+)',native['psycopg2']['ldd'],re.M)
 assert len(matches)==1,name
 path=Path(matches[0]).resolve();assert path.is_file() and path.is_absolute()
 system_dependencies[name]={'path':str(path),'sha256':sha(path),**elf(path.read_bytes())}
from cryptography.hazmat.bindings import _rust
rust=Path(_rust.__file__).resolve();assert rust.is_file()
report['native_components_measured']={
 'CPython':{'version':'.'.join(map(str,sys.version_info[:3])),'SOABI':sysconfig.get_config_var('SOABI'),'interpreter_path':str(Path(sys.executable).resolve()),'interpreter_sha256':sha(Path(sys.executable).resolve())},
 'Expat':{'reported_version':pyexpat.EXPAT_VERSION,'artifact_sha256':sha(artifact),'source_patch':'13c5f63','version_not_cosmetically_rewritten':True},
 'libpq_and_system_OpenSSL':{'libpq_compile_API':psycopg2.__libpq_version__,'libpq_runtime_API':extensions.libpq_version(),'OpenSSL_reported':ssl.OPENSSL_VERSION,'shared_objects':system_dependencies},
 'cryptography_bundled_OpenSSL':{'reported_version':backend.openssl_version_text(),'binding_path':str(rust),'binding_sha256':sha(rust),**elf(rust.read_bytes())}}
report['current_source_commit']='144c2a81362376e914bcfc490814b415f404c1d4'
