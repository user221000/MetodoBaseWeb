actual_app={p.relative_to('/app').as_posix():sha(p) for p in Path('/app').rglob('*') if p.is_file()}
assert actual_app==EXPECTED_APP,(set(actual_app)-set(EXPECTED_APP),set(EXPECTED_APP)-set(actual_app))
assert all(not p.is_symlink() for p in Path('/app').rglob('*'))
assert os.access('/app/entrypoint.sh',os.X_OK)
