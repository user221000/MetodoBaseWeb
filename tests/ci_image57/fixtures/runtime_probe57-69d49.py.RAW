att=Path('/usr/local/share/metodobase/expat-sec10')
prov=json.loads((att/'build-provenance.json').read_text());assert prov['artifact_sha256']==sha(artifact)
assert prov['base_exports']==prov['artifact_exports']==exports(artifact.read_bytes())==['PyInit_pyexpat']
