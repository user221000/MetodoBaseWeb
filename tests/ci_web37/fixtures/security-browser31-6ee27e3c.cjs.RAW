/* Independent security realms for the current browser wire. No author harness. */
'use strict';
const fs=require('node:fs'),vm=require('node:vm'),assert=require('node:assert/strict'),crypto=require('node:crypto');
const source=fs.readFileSync(process.env.SEC_BROWSER_SOURCE||'web/static/js/api.js','utf8');
const wait=()=>{let resolve;const promise=new Promise(r=>{resolve=r;});return{promise,resolve};};
const tick=()=>new Promise(resolve=>setImmediate(resolve));
function response(data,status=200){return{status,ok:status>=200&&status<300,headers:{get(){return null;}},json:async()=>data};}
function environment({legacy=null,locks=true}={}){
  const disk=new Map(),tabs=[],writes=[],messages=[],calls=[],reads=[];let lockTail=Promise.resolve(),held=0,maxHeld=0,seq=0;
  if(legacy)for(const[key,value]of Object.entries(legacy))disk.set(key,value);
  const cookie={actor:'A'};
  function tab(){
    const events=new Map(),sessionDisk=new Map();let hook=null,item;
    const emit=event=>{for(const fn of events.get(event.type)||[])fn(event);};
    function store(map,shared){return{getItem(key){reads.push({key,shared});return map.get(key)??null;},setItem(key,value){writes.push({key,value:String(value)});const old=map.get(key);map.set(key,String(value));if(shared&&old!==String(value))for(const peer of tabs)if(peer!==item)peer.emit({type:'storage',key});},removeItem(key){const existed=map.delete(key);if(existed&&shared)for(const peer of tabs)if(peer!==item)peer.emit({type:'storage',key});}};}
    class Channel{constructor(){this.onmessage=null;this.owner=item;}postMessage(data){messages.push(data);for(const peer of tabs)if(peer!==item)queueMicrotask(()=>peer.channel?.onmessage?.({data}));}}
    const channelClass=class extends Channel{constructor(...args){super(...args);queueMicrotask(()=>{if(item)item.channel=this;});}};
    const locksApi={request(name,opts,fn){assert.equal(name,'metodobase.browser-session.v1');assert.equal(opts.mode,'exclusive');const pending=lockTail.then(async()=>{held++;maxHeld=Math.max(held,maxHeld);try{return await fn();}finally{held--;}});lockTail=pending.catch(()=>{});return pending;}};
    const sandbox={TextEncoder,URL,URLSearchParams,FormData,File,Blob,AbortController,queueMicrotask,Promise,Map,Set,WeakMap,WeakSet,Object,Array,JSON,Number,String,Date,Error,RegExp,Event,crypto:crypto.webcrypto,navigator:locks?{locks:locksApi}:{},BroadcastChannel:channelClass,localStorage:store(disk,true),sessionStorage:store(sessionDisk,false),location:{pathname:'/mi-perfil',origin:'https://security.invalid',href:'https://security.invalid/mi-perfil'},setTimeout,clearTimeout,console:{log(){},warn(){},error(){}}};
    sandbox.window=sandbox;sandbox.addEventListener=(name,fn)=>{if(!events.has(name))events.set(name,[]);events.get(name).push(fn);};sandbox.removeEventListener=(name,fn)=>events.set(name,(events.get(name)||[]).filter(x=>x!==fn));sandbox.dispatchEvent=emit;
    sandbox.document={get cookie(){throw Error('HttpOnly is unavailable to script');}};
    sandbox.fetch=async(path,options={})=>{
      const call={path,options,body:options.body?JSON.parse(options.body):null,held};calls.push(call);
      if(hook){const result=await hook(call);if(result)return result;}
      if(path==='/api/auth/refresh'||path.endsWith('/browser/migrate')){assert.equal(held,1);return cookie.actor?response({token:'SEC-'+cookie.actor+'-'+(++seq),session_mode:'browser'}):response({detail:{code:'browser_session_unavailable'}},401);}
      if(['/api/auth/login','/api/auth/google','/api/auth/registro','/api/auth/accept-invite','/api/auth/mfa/login/verify'].includes(path)){assert.equal(held,1);cookie.actor='B';return response({token:'SEC-B-'+(++seq),session_mode:'browser',nombre:'Fixture identity',email:'fixture@example.invalid'});}
      if(path.endsWith('/browser/logout')){assert.equal(held,1);cookie.actor=null;return response({success:true,session_mode:'browser',server_confirmed:true});}
      return response({id:'A',tipo:'usuario',role:'owner',team_gym_id:null,session_version:1});
    };
    const context=vm.createContext(sandbox);vm.runInContext(source+'\nglobalThis.api=Api;',context);
    item={sandbox,context,api:sandbox.api,emit,sessionDisk,hook:fn=>{hook=fn;}};tabs.push(item);return item;
  }
  return{tab,disk,writes,messages,calls,reads,cookie,get held(){return held;},get maxHeld(){return maxHeld;}};
}
const tests=[],test=(name,run)=>tests.push({name,run});
async function ready(e){const t=e.tab();await t.api.session.ready;return t;}
const epoch=e=>e.disk.set('mb_session_epoch',crypto.randomUUID());
test('A delayed bootstrap does not expose bearer or send a private request',async()=>{const e=environment(),t=e.tab(),gate=wait(),entered=wait();t.hook(c=>c.path==='/api/auth/refresh'?{status:200,ok:true,headers:{get:()=>null},json:async()=>{entered.resolve();await gate.promise;return{token:'SEC-A-BOOT',session_mode:'browser'};}}:null);const pending=t.api.auth.me();await entered.promise;assert.equal(t.api.getToken(),'');assert.equal(e.calls.length,1);gate.resolve();await pending;assert.equal(e.calls.length,2);});
test('No Web Lock means no cookie or protected I/O',async()=>{const e=environment({locks:false}),t=e.tab();await assert.rejects(t.api.session.ready,{code:'browser_locks_unavailable'});await assert.rejects(t.api.auth.me());assert.equal(e.calls.length,0);assert.equal(t.api.getToken(),'');});
test('Legacy proof and personal metadata are removed before the only migration request',async()=>{const e=environment({legacy:{mb_token:'legacy-access',mb_refresh_token:'legacy-refresh',mb_nombre:'Legacy name',mb_email:'legacy@example.invalid',mb_tipo:'gym'}}),t=e.tab();for(const key of ['mb_token','mb_refresh_token','mb_nombre','mb_email','mb_tipo'])assert.equal(e.disk.has(key),false);await t.api.session.ready;assert.equal(e.calls.length,1);assert.equal(e.calls[0].path,'/api/auth/browser/migrate');assert.deepEqual(e.calls[0].body,{refresh_token:'legacy-refresh'});});
test('Access and metadata never enter either Storage or cross-tab messages',async()=>{const e=environment(),t=await ready(e);await t.api.auth.registro({email:'fixture@example.invalid',password:'fixture-password'});assert.equal(t.api.session.identity().email,'fixture@example.invalid');assert.ok(e.writes.every(x=>x.key==='mb_session_epoch'));assert.equal(t.sessionDisk.size,0);assert.ok(e.messages.every(x=>Object.keys(x).join(',')==='epoch'));assert.ok(e.messages.every(x=>!JSON.stringify(x).includes('fixture')));});
for(const kind of ['epoch-read-only','storage-event','broadcast','pagehide','bfcache'])test('A '+kind+' boundary rejects a late private JSON result',async()=>{const e=environment(),t=await ready(e),gate=wait(),entered=wait();t.hook(c=>c.path==='/api/auth/me'?{status:200,ok:true,headers:{get:()=>null},json:async()=>{entered.resolve();await gate.promise;return{id:'A'};}}:null);const pending=t.api.auth.me();await entered.promise;if(kind==='epoch-read-only')epoch(e);if(kind==='storage-event')t.emit({type:'storage',key:'mb_session_epoch'});if(kind==='broadcast')t.channel.onmessage({data:{epoch:crypto.randomUUID()}});if(kind==='pagehide')t.emit({type:'pagehide'});if(kind==='bfcache')t.emit({type:'pageshow',persisted:true});gate.resolve();await assert.rejects(pending,{code:'session_changed'});assert.equal(t.api.getToken(),'');const count=e.calls.length;await assert.rejects(t.api.auth.me(),{code:'session_changed'});assert.equal(e.calls.length,count);});
for(const mode of ['same-epoch','extra-field','wrong-type'])test('A non-boundary '+mode+' broadcast does not replace RAM identity',async()=>{const e=environment(),t=await ready(e),before=t.api.getToken();const data=mode==='same-epoch'?{epoch:e.disk.get('mb_session_epoch')}:mode==='extra-field'?{epoch:crypto.randomUUID(),token:'ATTACKER'}:{epoch:{token:'ATTACKER'}};t.channel.onmessage({data});assert.equal(t.api.getToken(),before);});
test('External actor selection invalidates the other tab without adopting its access',async()=>{const e=environment(),a=await ready(e),b=await ready(e);const old=b.api.getToken();await a.api.auth.registro({});assert.match(a.api.getToken(),/^SEC-B-/);assert.equal(b.api.getToken(),'');assert.notEqual(a.api.getToken(),old);const before=e.calls.length;const out=await b.api.auth.logout();assert.equal(out.server_confirmed,false);assert.equal(out.state,'session_changed');assert.equal(e.calls.length,before);assert.equal(e.cookie.actor,'B');});
test('Cookie lock spans delayed primary JSON and prevents a queued logout from overtaking it',async()=>{const e=environment(),t=await ready(e),gate=wait(),entered=wait();t.hook(c=>c.path==='/api/auth/login'?{status:200,ok:true,headers:{get:()=>null},json:async()=>{entered.resolve();await gate.promise;return{token:'SEC-B-ACK',session_mode:'browser'};}}:null);const h=t.api.mfa.capture(),login=t.api.mfa.primaryPassword({},h);await entered.promise;const logout=t.api.auth.logout();await tick();assert.equal(e.held,1);assert.equal(e.calls.filter(x=>x.path.endsWith('/browser/logout')).length,0);gate.resolve();const body=await login;await logout;assert.throws(()=>t.api.mfa.finishLogin(body,h),{code:'session_changed'});assert.equal(t.api.getToken(),'');assert.equal(e.maxHeld,1);});
test('An acknowledgement cannot be fabricated through public saveTokens',async()=>{const e=environment(),t=await ready(e),old=t.api.getToken();assert.throws(()=>t.api.saveTokens({token:'SEC-B-FORGED',session_mode:'browser'}),{code:'browser_protocol_invalid'});assert.equal(t.api.getToken(),old);});
test('A genuine primary acknowledgement is single-use',async()=>{const e=environment(),t=await ready(e),h=t.api.mfa.capture(),reply=await t.api.mfa.primaryPassword({},h);t.api.mfa.finishLogin(reply,h);assert.match(t.api.getToken(),/^SEC-B-/);assert.throws(()=>t.api.saveTokens(reply),{code:'browser_protocol_invalid'});});
test('An ordinary body is copied before its bootstrap await',async()=>{const e=environment(),t=e.tab(),gate=wait(),entered=wait();t.hook(c=>c.path==='/api/auth/refresh'?{status:200,ok:true,headers:{get:()=>null},json:async()=>{entered.resolve();await gate.promise;return{token:'SEC-A-BOOT',session_mode:'browser'};}}:null);const body={nombre:'initial'},pending=t.api.clientes.crear(body);body.nombre='later';await entered.promise;gate.resolve();await pending;assert.equal(e.calls.find(c=>c.path==='/api/clientes').body.nombre,'initial');});
test('A cookie body is copied before joining the shared lock queue',async()=>{const e=environment(),t=await ready(e),gate=wait(),entered=wait();let expired=true;t.hook(c=>{if(c.path==='/api/auth/me'&&expired){expired=false;return response({},401);}if(c.path==='/api/auth/refresh')return{status:200,ok:true,headers:{get:()=>null},json:async()=>{entered.resolve();await gate.promise;return{token:'SEC-A-ROTATED',session_mode:'browser'};}};});const renew=t.api.auth.me();await entered.promise;const body={password:'initial'},signup=t.api.auth.registro(body),both=Promise.allSettled([renew,signup]);body.password='later';gate.resolve();await both;assert.equal(e.calls.find(c=>c.path==='/api/auth/registro').body.password,'initial');});
for(const namespace of ['nutrition','followup'])test('A purpose-closed '+namespace+'401 sends once and cannot refresh or replay',async()=>{const e=environment(),t=await ready(e),h=t.api.mfa.capture(),before=e.calls.length;t.hook(()=>response({detail:'Rejected'},401));await assert.rejects(namespace==='nutrition'?t.api.nutrition.client('client-A',h):t.api.followup.contexto(h));assert.equal(e.calls.length-before,1);assert.equal(e.calls.at(-1).path.startsWith('/api/auth/refresh'),false);});
for(const status of [401,503])test('Uncertain or rejected primary status '+status+' leaves RAM empty and performs no cookie fallback',async()=>{const e=environment(),t=await ready(e),h=t.api.mfa.capture(),before=e.calls.length;t.hook(()=>response({detail:{code:'browser_session_unconfirmed'}},status));await assert.rejects(t.api.mfa.primaryPassword({},h));assert.equal(t.api.getToken(),'');assert.equal(e.calls.length-before,1);});
test('A delayed refresh cannot adopt its token after an unseen epoch change',async()=>{const e=environment(),t=await ready(e),gate=wait(),entered=wait();let expired=true;t.hook(c=>{if(c.path==='/api/auth/me'&&expired){expired=false;return response({},401);}if(c.path==='/api/auth/refresh')return{status:200,ok:true,headers:{get:()=>null},json:async()=>{entered.resolve();await gate.promise;return{token:'SEC-B-LATE',session_mode:'browser'};}};});const pending=t.api.auth.me();await entered.promise;epoch(e);gate.resolve();await assert.rejects(pending,{code:'session_changed'});assert.equal(t.api.getToken(),'');assert.equal(e.calls.filter(c=>c.path==='/api/auth/me').length,1);});
test('A refresh with ambiguous JSON invalidates before a queued tab can rotate the cookie',async()=>{const e=environment(),a=await ready(e),b=await ready(e),gate=wait(),entered=wait();let expired=true;a.hook(c=>{if(c.path==='/api/auth/me'&&expired){expired=false;return response({},401);}if(c.path==='/api/auth/refresh')return{status:200,ok:true,headers:{get:()=>null},json:async()=>{entered.resolve();await gate.promise;throw Error('Private parse detail');}};});const pending=a.api.auth.me();await entered.promise;let secondExpired=true;b.hook(c=>{if(c.path==='/api/auth/me'&&secondExpired){secondExpired=false;return response({},401);}});const queued=b.api.auth.me(),both=Promise.allSettled([pending,queued]);await tick();const before=e.calls.filter(c=>c.path==='/api/auth/refresh').length;gate.resolve();const outcomes=await both;assert.ok(outcomes.every(x=>x.status==='rejected'));assert.equal(e.calls.filter(c=>c.path==='/api/auth/refresh').length,before);assert.equal(a.api.getToken(),'');assert.equal(b.api.getToken(),'');});
test('Denied epoch storage never exposes a raw exception or retains usable access',async()=>{const e=environment(),t=await ready(e);t.sandbox.localStorage.getItem=()=>{throw new DOMException('PRIVATE SECURITY DETAIL','SecurityError');};assert.equal(t.api.getToken(),'');await assert.rejects(t.api.auth.me(),error=>error.code==='session_storage_error'&&!error.message.includes('PRIVATE'));assert.equal(t.api.session.identity(),null);});
test('A legacy-shaped bootstrap response is rejected without a Storage fallback',async()=>{const e=environment(),t=e.tab();t.hook(()=>response({token:'SEC-A-ACCESS',refresh_token:'FORBIDDEN',session_mode:'browser'}));await assert.rejects(t.api.session.ready,{code:'browser_protocol_invalid'});assert.equal(t.api.getToken(),'');assert.ok(e.writes.every(x=>x.key==='mb_session_epoch'));});
(async()=>{const rows=[];for(const entry of tests){try{await entry.run();rows.push({case:entry.name,passed:true});}catch(error){rows.push({case:entry.name,passed:false,error_class:error.name,code:typeof error.code==='string'?error.code:null,site:String(error.stack).split('\n').find(line=>line.trimStart().startsWith('at '))});}}process.stdout.write(JSON.stringify({scope:'Independent VM source/realm boundaries. Cookie, Lock and transport doubles; no native browser or server acceptance.',total:rows.length,passed:rows.filter(x=>x.passed).length,rows},null,2)+'\n');if(rows.some(x=>!x.passed))process.exitCode=1;})();
