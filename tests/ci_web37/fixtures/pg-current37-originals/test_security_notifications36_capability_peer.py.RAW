"""Independent contact, disable-only capability and handoff security boundaries."""
import uuid
from dataclasses import replace
from datetime import UTC, datetime, timedelta
from urllib.parse import parse_qs, urlsplit

import pytest
from fastapi import HTTPException
from sqlalchemy import event, select
from sqlalchemy.orm import Session

from tests import notifications36_http as current_http
from tests.test_notifications36_http import (
    billing,
    candidate,
    observe,
    preference,
    queue,
)
from web.database.models import (
    NotificationAttempt,
    NotificationOutbox,
    NotificationPreference,
    Usuario,
)
from web.services import notification_worker as worker
from web.services import notifications as service
from web.services.notification_domain import SendResult

followup_db = current_http.followup_db
notification_http = current_http.notification_http
DEFAULT_ACK = SendResult("accepted", "independent-provider-ack")


class RecordingPort:
    enabled = True

    def __init__(self, result=DEFAULT_ACK):
        self.result = result
        self.calls = []

    def send(self, message):
        self.calls.append(message)
        return self.result


def canonical_origin():
    from web.services.password_recovery import public_origin
    from web.settings import get_settings
    return public_origin(get_settings())


def prepared(case, monkeypatch):
    billing(case, monkeypatch)
    assert preference(case).status_code == 200
    assert observe(case).status_code == 200
    response = queue(case, candidate(case))
    assert response.status_code == 200
    return response.json()["outbox"]["id"]


def exclusion(case, identifier):
    port = RecordingPort()
    result = worker.run_one(case["user"], "gym", identifier, canonical_origin(), port, factory=case["factory"])
    assert result["outbox"]["state"] == "accepted" and len(port.calls) == 1
    return parse_qs(urlsplit(port.calls[0].exclusion_url).fragment)["token"][0]


def current(case, purpose="confirmed_payment_issue"):
    with Session(case["admin"]) as db:
        row = db.scalar(select(NotificationPreference).where(
            NotificationPreference.user_id == case["user"], NotificationPreference.purpose == purpose
        ).order_by(NotificationPreference.version.desc()))
        return None if row is None else (row.id, row.version, row.enabled)


def test_old_disable_capability_cannot_undo_a_later_explicit_opt_in(notification_http, monkeypatch):
    case = notification_http
    token = exclusion(case, prepared(case, monkeypatch))
    assert preference(case, enabled=False, version=1).status_code == 200
    assert preference(case, enabled=True, version=2).status_code == 200
    fresh = current(case)
    case["raw"].headers.pop("Authorization", None)
    response = case["raw"].post("/api/notificaciones/excluir", json={"token": token})
    assert response.status_code == 200 and response.json() == {"success": True}
    assert current(case) == fresh and fresh[1:] == (3, True)


def test_disable_capability_never_disables_the_other_purpose(notification_http, monkeypatch):
    case = notification_http
    token = exclusion(case, prepared(case, monkeypatch))
    assert preference(case, purpose="account_period_end").status_code == 200
    other = current(case, "account_period_end")
    assert service.exclude(token, factory=case["factory"]) == {"success": True}
    assert current(case)[2] is False
    assert current(case, "account_period_end") == other and other[2] is True


def test_expired_capability_and_random_capability_are_indistinguishable_noops(notification_http, monkeypatch):
    case = notification_http
    token = exclusion(case, prepared(case, monkeypatch))
    prior = current(case)
    expired = datetime.now(UTC) + timedelta(days=31)
    assert service.exclude(token, factory=case["factory"], now=expired) == {"success": True}
    assert service.exclude("X" * 43, factory=case["factory"], now=expired) == {"success": True}
    assert current(case) == prior


def test_contact_aba_after_claim_suppresses_before_contact_leaves_the_database(notification_http, monkeypatch):
    case = notification_http
    identifier = prepared(case, monkeypatch)
    claimed = worker.claim(case["user"], "gym", identifier, factory=case["factory"])
    with Session(case["admin"]) as db:
        actor = db.get(Usuario, case["user"])
        original = actor.email
        actor.email = uuid.uuid4().hex + "@example.invalid"
        db.commit()
        actor.email = original
        db.commit()
        assert actor.notification_contact_version == 2
    assert worker.prepare_handoff(claimed, canonical_origin(), factory=case["factory"]) is None
    with Session(case["admin"]) as db:
        assert db.get(NotificationOutbox, identifier).state == "suppressed"
        assert db.scalar(select(NotificationAttempt.kind).where(NotificationAttempt.outbox_id == identifier)) == "suppressed"


def test_forged_lease_token_or_fence_never_exposes_a_message(notification_http, monkeypatch):
    case = notification_http
    identifier = prepared(case, monkeypatch)
    claimed = worker.claim(case["user"], "gym", identifier, factory=case["factory"])
    for forged in (replace(claimed, token="X" * 43), replace(claimed, fence=claimed.fence + 1)):
        with pytest.raises(HTTPException) as denied:
            worker.prepare_handoff(forged, canonical_origin(), factory=case["factory"])
        assert denied.value.status_code == 409
    with Session(case["admin"]) as db:
        row = db.get(NotificationOutbox, identifier)
        assert row.state == "leased" and row.version == claimed.fence and row.attempt_count == 0


def test_disabled_transport_does_not_even_claim_the_pending_intent(notification_http, monkeypatch):
    case = notification_http
    identifier = prepared(case, monkeypatch)
    with pytest.raises(HTTPException) as denied:
        worker.run_one(case["user"], "gym", identifier, canonical_origin(), factory=case["factory"])
    assert denied.value.status_code == 503
    with Session(case["admin"]) as db:
        row = db.get(NotificationOutbox, identifier)
        assert row.state == "pending" and row.version == 1 and row.attempt_count == 0


@pytest.mark.parametrize("outcome", [True, SendResult("accepted", "   ")])
def test_legacy_bool_or_invalid_provider_ack_is_uncertain_and_never_retried(notification_http, monkeypatch, outcome):
    case = notification_http
    identifier = prepared(case, monkeypatch)
    port = RecordingPort(outcome)
    result = worker.run_one(case["user"], "gym", identifier, canonical_origin(), port, factory=case["factory"])
    assert result["outbox"]["state"] == "uncertain" and len(port.calls) == 1
    with pytest.raises(HTTPException):
        worker.run_one(case["user"], "gym", identifier, canonical_origin(), port, factory=case["factory"])
    assert len(port.calls) == 1


def test_authority_locks_fetch_no_email_name_or_password_columns(notification_http, monkeypatch):
    case = notification_http
    with Session(case["admin"]) as db:
        expected = {"id": case["user"], "session_version": db.get(Usuario, case["user"]).session_version}
    statements = []
    def capture(_connection, _cursor, statement, _parameters, _context, _many):
        statements.append(statement.lower())
    event.listen(case["engine"], "before_cursor_execute", capture)
    try:
        result = service.context(expected, "gym", factory=case["factory"])
        assert result["context"] == "gym"
    finally:
        event.remove(case["engine"], "before_cursor_execute", capture)
    # The real signed HTTP principal was established by the fixture. This
    # capture is the owned authority service only, including every SQL SELECT.
    authority = [sql for sql in statements if sql.lstrip().startswith("select")
                 and "usuarios.notification_contact_version" in sql]
    assert len(authority) >= 2
    for sql in authority:
        projection = sql.split(" from ", 1)[0]
        assert all("usuarios." + field not in projection for field in ("email", "nombre", "password_hash"))
